{
  "settings": {
    "autoAuth": true
  },
  "mcpServers": {
    "sessions": {
      "command": "/opt/homebrew/bin/sessions",
      "args": ["--mcp"],
      "cwd": "/Users/nicknisi/Developer/sessions"
    },
    "notion": {
      "url": "https://mcp.notion.com/mcp",
      "auth": "oauth"
    },
    "granola": {
      "url": "https://mcp.granola.ai/mcp",
      "auth": "oauth"
    },
    "linear": {
      "url": "https://mcp.linear.app/sse",
      "auth": "oauth"
    },
    "slack": {
      "command": "npx",
      "args": ["-y", "slack-mcp-server"],
      "env": {
        "SLACK_MCP_XOXP_TOKEN": "!cat ~/.slack/service-token"
      },
      "lifecycle": "lazy"
    }
  }
}
