{
  "settings": {
    "autoAuth": true
  },
  "mcpServers": {
    "horizon": {
      "url": "https://horizon.workos.tools/mcp",
      "auth": "oauth",
      "oauth": {
        "scope": "horizon:mcp"
      }
    },
    "sessions": {
      "command": "/opt/homebrew/bin/sessions",
      "args": [
        "--mcp"
      ],
      "cwd": "/Users/nicknisi/Developer/sessions"
    },
    "ctx": {
      "url": "https://ctx.nicknisi.com/mcp",
      "headers": {
        "Authorization": "Bearer ${CTX_TOKEN}"
      }
    },
    "notion": {
      "url": "https://mcp.notion.com/mcp",
      "auth": "oauth",
      "directTools": true
    },
    "granola": {
      "url": "https://mcp.granola.ai/mcp",
      "auth": "oauth",
      "directTools": true
    },
    "excalidraw": {
      "url": "https://api.excalidraw.com/api/v1/mcp",
      "headers": {
        "Authorization": "Bearer ${EXCALIDRAW_API_TOKEN}"
      }
    },
    "linear": {
      "url": "https://mcp.linear.app/mcp",
      "auth": "oauth"
    },
    "slack": {
      "url": "https://mcp.slack.com/mcp",
      "auth": "oauth",
      "oauth": {
        "clientId": "1601185624273.8899143856786",
        "redirectUri": "http://localhost:3118/callback"
      },
      "directTools": true
    }
  }
}
