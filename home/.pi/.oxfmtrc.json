{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "trailingComma": "all",
  "tabWidth": 2,
  "semi": true,
  "singleQuote": true,
  "printWidth": 120,
  "sortPackageJson": true,
  "ignorePatterns": [
    "node_modules/",
    "agent/git/",
    "agent/npm/",
    "agent/sessions/",
    "agent/pi-hermes-memory/",
    "agent/projects-memory/",
    "agent/extensions/mcp.local.bak/"
  ]
}
