#!/usr/bin/env bash
# theme — the whole desktop theme, one command.
#
# A pack is themes/<name>/: colors.toml (the contract), backgrounds/, and
# optionally theme.conf (TAGLINE="..."), icons.theme, and any app file it
# wants to hand-tune. Everything else an app reads is rendered from
# themes/templates/*.tpl by bin/theme-color at switch time; a file the pack
# ships under the same name wins over the template. A theme repo laid out this
# way drops in unchanged, on plain Arch and on macOS.
#
# State (the only paths consumers read):
#   ~/.local/state/theme/current/theme/      the rendered pack, swapped atomically
#   ~/.local/state/theme/current/background  -> the active wallpaper
#   ~/.local/state/theme/current/theme.name
#   ~/.local/state/theme/current/mode        dark | light
#   ~/.local/state/theme/current/colors.json the resolved palette (quickshell watches it)

set -euo pipefail

case "$(uname -s)" in Darwin) IS_MAC=true ;; *) IS_MAC=false ;; esac

SOURCE="${BASH_SOURCE[0]}"
[ -L "$SOURCE" ] && SOURCE="$(readlink "$SOURCE")"
DOTFILES="$(cd "$(dirname "$SOURCE")/.." && pwd)"
THEMES_DIR="$DOTFILES/themes"
TEMPLATES_DIR="$THEMES_DIR/templates"
STATE="$HOME/.local/state/theme/current"
CACHE="${XDG_CACHE_HOME:-$HOME/.cache}/theme"
COLOR="$DOTFILES/bin/theme-color"

die() { echo "theme: $1" >&2; exit "${2:-1}"; }

usage() {
  cat <<'USAGE'
theme — the whole desktop theme, one command

usage:
  theme                       pick a theme (and wallpaper) interactively
  theme <name> [N]            switch; N = Nth wallpaper (default 1)
  theme set <name> [N]        same
  theme next | prev           cycle themes
  theme bg [next|prev|N|path] change only the wallpaper
  theme picker [themes|backgrounds]
                              the carousel overlay (quickshell); what the "Theme"
                              and "Wallpaper" entries in wofi run
  theme menu                  plain wofi list (the fallback when no shell runs)
  theme thumbs                cache picker thumbnails (runs itself after a switch)
  theme refresh               re-render the current theme (after editing a template)
  theme browser install       install managed Chromium/Helium theme policy (sudo once)
  theme plymouth              install the rendered boot splash (LUKS prompt) and rebuild
                              the initramfs; deliberate, needs sudo, shows on next boot
  theme list                  themes with their palettes and taglines
  theme current               the active theme
  theme from-image <name> <image>
                              grow a new pack from a wallpaper
  theme adopt <image>         add wallpaper to closest existing theme, if close
  theme -h, --help            this

A pack is themes/<name>/colors.toml + backgrounds/. Every app file is
rendered from themes/templates/*.tpl into ~/.local/state/theme/current/theme/.

switches: ghostty, kitty, wezterm, tmux, nvim, btop, lazygit, delta, fzf,
          starship, pi, claude code,
          wallpaper, and Chromium/Helium after `theme browser install`; Linux adds
          hyprland borders, hyprlock, wofi, quickshell, GTK dark/light + icons;
          macOS adds appearance, sketchybar, borders, slack.
          The boot splash is rendered too but only installed by `theme plymouth`,
          because that means rebuilding the initramfs.
USAGE
}

# ── Packs ────────────────────────────────────────────────────────

list_themes() {
  local d
  for d in "$THEMES_DIR"/*/; do
    [ -f "$d/colors.toml" ] && basename "$d"
  done
}
current_theme() { cat "$STATE/theme.name" 2>/dev/null || echo none; }
current_mode() { cat "$STATE/mode" 2>/dev/null || echo dark; }
backgrounds() { # theme -> image paths, sorted
  find -L "$THEMES_DIR/$1/backgrounds" -maxdepth 1 -type f \
    \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' -o -iname '*.gif' -o -iname '*.webp' -o -iname '*.bmp' \) \
    2>/dev/null | sort
}
tagline() { (source "$1/theme.conf" 2>/dev/null; printf '%s' "${TAGLINE:-}"); }

# ── Palette helpers (grep, not theme-color: `theme list` runs these 26×7 times) ─

hex() { # KEY... DIR -> first key present in DIR/colors.toml
  local dir="${*: -1}" k v
  for k in "${@:1:$#-1}"; do
    v="$(sed -n "s/^${k}[[:space:]]*=[[:space:]]*\"\(#[0-9A-Fa-f]\{6\}\)\".*/\1/p" "$dir/colors.toml" 2>/dev/null | head -1)"
    [ -n "$v" ] && { printf '%s' "$v"; return; }
  done
}
rgb() { local h="${1#\#}"; printf '%d;%d;%d' "0x${h:0:2}" "0x${h:2:2}" "0x${h:4:2}"; }

swatches() { # DIR -> truecolor ██ row (accent + six hues)
  local dir="$1" c out=""
  for c in "$(hex accent blue "$dir")" "$(hex red color1 "$dir")" "$(hex green color2 "$dir")" \
    "$(hex yellow color3 "$dir")" "$(hex blue color4 "$dir")" "$(hex magenta color5 "$dir")" "$(hex cyan color6 "$dir")"; do
    [ -n "$c" ] && out+=$'\033[38;2;'"$(rgb "$c")"$'m██\033[0m '
  done
  printf '%s' "$out"
}

name_painted() { # DIR NAME -> name in its accent colour
  printf '\033[1m\033[38;2;%sm%s\033[0m' "$(rgb "$(hex accent blue "$1")")" "$2"
}

# ── Interactive picking (fzf) ────────────────────────────────────

preview_theme() {
  local dir="$THEMES_DIR/$1"
  [ -d "$dir" ] || exit 0
  name_painted "$dir" "$1"
  local t; t="$(tagline "$dir")"
  [ -n "$t" ] && printf '  \033[2m%s\033[0m' "$t"
  printf '\n%s\n' "$(swatches "$dir")"
  printf '\033[2m%s wallpaper(s)\033[0m\n' "$(backgrounds "$1" | wc -l | tr -d ' ')"
}

preview_bg() { # THEME N
  local img; img="$(backgrounds "$1" | sed -n "$2p")"
  [ -n "$img" ] || exit 0
  printf '\033[1m%s\033[0m\n' "$(basename "$img")"
  local kitten cols="${FZF_PREVIEW_COLUMNS:-80}" rows=$(( ${FZF_PREVIEW_ROWS:-20} - 2 ))
  kitten="$(command -v kitten || true)"
  [ -x /Applications/kitty.app/Contents/MacOS/kitten ] && kitten=/Applications/kitty.app/Contents/MacOS/kitten
  if [ -n "$kitten" ] && { [ "${TERM_PROGRAM:-}" = ghostty ] || [ "${TERM_PROGRAM:-}" = kitty ]; }; then
    # kitty graphics protocol (ghostty speaks it); must bypass fzf's capture
    "$kitten" icat --clear --transfer-mode=memory --stdin=no --scale-up \
      --place "${cols}x${rows}@0x2" "$img" >/dev/tty 2>/dev/null || true
  elif command -v chafa >/dev/null 2>&1; then
    chafa -s "${cols}x${rows}" "$img" 2>/dev/null || true
  elif command -v img2txt >/dev/null 2>&1; then
    img2txt -W "$cols" -H "$rows" "$img" 2>/dev/null || true
  fi
}

pick_theme() {
  command -v fzf >/dev/null 2>&1 && [ -t 0 ] || {
    list_themes
    die "pass a name, e.g. theme $(current_theme)" 2
  }
  local name n bg=1
  name="$(list_themes | fzf --prompt='theme ❯ ' --reverse --height=~60% \
    --preview="'$DOTFILES'/bin/theme _preview-theme {}" \
    --preview-window='right,50%,border-left')" || exit 130
  [ -n "$name" ] || exit 130
  n="$(backgrounds "$name" | wc -l | tr -d ' ')"
  if [ "$n" -gt 1 ]; then
    bg="$(seq 1 "$n" | fzf --prompt='wallpaper ❯ ' --reverse --height=~40% \
      --preview="'$DOTFILES'/bin/theme _preview-bg $name {}" \
      --preview-window='right,60%,border-left')" || exit 130
    [ -n "$bg" ] || exit 130
  fi
  apply "$name" "$bg"
}

cmd_menu() { # wofi picker, for a keybind
  command -v wofi >/dev/null 2>&1 || die "menu needs wofi"
  local cur pick style=()
  [ -f "$STATE/theme/wofi.css" ] && style=(--style "$STATE/theme/wofi.css")
  cur="$(current_theme)"
  pick="$(list_themes | sed "s/^$cur\$/& ✓/" | wofi --dmenu --insensitive --prompt theme "${style[@]}" 2>/dev/null)" || exit 0
  pick="${pick% ✓}"
  [ -n "$pick" ] || exit 0
  apply "$pick" 1
}

neighbour_theme() { # next|prev
  local cur themes=() i n
  cur="$(current_theme)"
  while read -r t; do themes+=("$t"); done < <(list_themes)
  n=${#themes[@]}
  for i in "${!themes[@]}"; do
    if [ "${themes[$i]}" = "$cur" ]; then
      [ "$1" = next ] && echo "${themes[$(((i + 1) % n))]}" || echo "${themes[$(((i - 1 + n) % n))]}"
      return
    fi
  done
  echo "${themes[0]}"
}

# ── Image palettes ──────────────────────────────────────────────
# ponytail: heuristic hue mapping, not a perceptual model. If a slot
# looks off, edit colors.toml by hand — that file is the contract.

palette_from_image() { # IMG -> colors.toml
  local IMG="$1" PYSCRIPT
  PYSCRIPT="$(cat <<'PYEOF'
import colorsys, re, sys

entries = []  # (count, r, g, b) 0-255
for line in sys.stdin:
    m = re.match(r"\s*(\d+):.*?#([0-9A-Fa-f]{6})", line)
    if m:
        h = m.group(2)
        entries.append((int(m.group(1)), int(h[0:2], 16), int(h[2:4], 16), int(h[4:6], 16)))
if not entries:
    sys.exit("theme: no colors extracted")

def hls(r, g, b):
    return colorsys.rgb_to_hls(r / 255, g / 255, b / 255)  # h, l, s

def rgb_hex(r, g, b):
    return "#%02x%02x%02x" % (max(0, min(255, round(r))), max(0, min(255, round(g))), max(0, min(255, round(b))))

def mix(c, t, f):  # toward t by f
    return tuple(a + (b - a) * f for a, b in zip(c, t))

def shift_hue(c, target_deg):
    h, l, s = hls(*c)
    r, g, b = colorsys.hls_to_rgb(target_deg / 360, max(0.3, min(0.7, l)), max(0.4, s))
    return (r * 255, g * 255, b * 255)

C = [(n, (r, g, b)) for n, r, g, b in entries]

def best(pred, fallback_key):
    pool = [(n, c) for n, c in C if pred(*hls(*c))]
    if pool:
        return max(pool)[1]
    return max(C, key=lambda nc: fallback_key(*hls(*nc[1])))[1]

bg = best(lambda h, l, s: l < 0.28, lambda h, l, s: -l)
fg = best(lambda h, l, s: l > 0.72, lambda h, l, s: l)
if hls(*fg)[1] - hls(*bg)[1] < 0.5:  # unreadable pair: force extremes
    bg = tuple(x * 0.4 for x in bg) if hls(*bg)[1] > 0.15 else bg
    fg = mix(fg, (255, 255, 255), 0.6)

accent = best(lambda h, l, s: s > 0.3 and 0.3 < l < 0.75, lambda h, l, s: s - abs(l - 0.5))

FAMILIES = {  # ansi slot -> hue center
    1: 0,    # red
    2: 120,  # green
    3: 55,   # yellow
    4: 230,  # blue
    5: 285,  # magenta
    6: 185,  # cyan
}

def family(center):
    lo, hi = (center - 30) % 360, (center + 30) % 360
    pool = [(n, c) for n, c in C
            if (lambda h, l, s: (lo <= h * 360 <= hi if lo < hi else h * 360 >= lo or h * 360 <= hi)
                and s > 0.15 and 0.25 < l < 0.8)(*hls(*c))]
    if pool:
        return max(pool)[1]
    return shift_hue(accent, center)  # hue family absent: rotate the accent

slots = {i: family(FAMILIES[i]) for i in FAMILIES}

def lighten(c):
    h, l, s = hls(*c)
    r, g, b = colorsys.hls_to_rgb(h, l + (1 - l) * 0.25, s * 0.95)
    return (r * 255, g * 255, b * 255)

hexes = {
    "accent": rgb_hex(*accent),
    "cursor": rgb_hex(*accent),
    "foreground": rgb_hex(*fg),
    "background": rgb_hex(*bg),
    "selection_foreground": rgb_hex(*bg),
    "selection_background": rgb_hex(*accent),
    "color0": rgb_hex(*mix(bg, fg, 0.12)),
    "color7": rgb_hex(*mix(fg, bg, 0.15)),
    "color8": rgb_hex(*mix(bg, fg, 0.4)),
    "color15": rgb_hex(*fg),
}
for i, c in slots.items():
    hexes["color%d" % i] = rgb_hex(*c)
    hexes["color%d" % (i + 8)] = rgb_hex(*lighten(c))

print("# extracted from a wallpaper by theme from-image")
for k in ("accent", "cursor", "foreground", "background", "selection_foreground", "selection_background"):
    print('%s = "%s"' % (k, hexes[k]))
print()
for i in range(16):
    print('color%d = "%s"' % (i, hexes["color%d" % i]))
PYEOF
)"
  magick "$IMG" -dither None -resize 240x240 -colors 24 -format %c histogram:info:- 2>/dev/null | python3 -c "$PYSCRIPT"
}

image_slug() { # IMG -> lowercase safe filename
  local slug
  slug="$(basename "$1" | tr '[:upper:]' '[:lower:]' | sed 's/^[0-9][0-9]*-//; s/[^a-z0-9.]\+/-/g; s/^-//; s/-$//')"
  printf '%s' "${slug:-wallpaper}"
}

add_wallpaper() { # THEME IMG -> repo-relative destination
  local theme="$1" IMG="$2" f base n max=0 slug dest
  local dir="$THEMES_DIR/$theme/backgrounds"
  mkdir -p "$dir"
  while IFS= read -r f; do
    base="$(basename "$f")"
    n="${base%%-*}"
    case "$n" in '' | *[!0-9]*) continue ;; esac
    if (( 10#$n > max )); then max=$((10#$n)); fi
  done < <(backgrounds "$theme")
  slug="$(image_slug "$IMG")"
  dest="$dir/$((max + 1))-$slug"
  [ -e "$dest" ] && die "wallpaper already exists: ${dest#"$DOTFILES"/}"
  cp "$IMG" "$dest"
  printf '%s' "${dest#"$DOTFILES"/}"
}

adopt_matches() { # colors.toml -> NAME<TAB>SCORE, best first
  local palette="$1" PYSCRIPT t
  PYSCRIPT="$(cat <<'PYEOF'
import math, re, sys
from collections import defaultdict

KEYS = ["background", "foreground", "accent"] + ["color%d" % i for i in range(16)]
WEIGHTS = {k: 1 for k in KEYS}
WEIGHTS.update(background=3, foreground=2, accent=3)
palettes = defaultdict(dict)
for line in sys.stdin:
    parts = line.rstrip("\n").split("\t", 2)
    if len(parts) != 3:
        continue
    name, key, value = parts
    if key not in WEIGHTS or not re.match(r"#[0-9a-fA-F]{6}$", value):
        continue
    h = value.lstrip("#")
    palettes[name][key] = tuple(int(h[i:i + 2], 16) for i in (0, 2, 4))

image = palettes.pop("__image__", None)
if not image:
    sys.exit("theme: no colors extracted")

out = []
for name, palette in palettes.items():
    total = weight = 0
    for key, w in WEIGHTS.items():
        if key not in image or key not in palette:
            continue
        total += w * sum((a - b) ** 2 for a, b in zip(image[key], palette[key]))
        weight += w
    if weight:
        out.append((math.sqrt(total / weight), name))

for score, name in sorted(out):
    print("%s\t%d" % (name, round(score)))
PYEOF
)"
  {
    "$COLOR" -f "$palette" --all | awk -v n="__image__" '{ print n "\t" $0 }'
    while IFS= read -r t; do
      "$COLOR" -f "$THEMES_DIR/$t/colors.toml" --all | awk -v n="$t" '{ print n "\t" $0 }'
    done < <(list_themes)
  } | python3 -c "$PYSCRIPT"
}

cmd_from_image() {
  [ "${1:-}" = "-h" ] || [ "${1:-}" = "--help" ] && { usage; exit 0; }
  [ $# -eq 2 ] || { usage >&2; exit 2; }
  local NAME="$1" IMG="$2"
  command -v magick >/dev/null 2>&1 || die "from-image needs ImageMagick (brew install imagemagick / pacman -S imagemagick)"
  [ -f "$IMG" ] || die "no such image: $IMG"
  [ -d "$THEMES_DIR/$NAME" ] && die "themes/$NAME already exists"

  local COLORS_TOML
  COLORS_TOML="$(palette_from_image "$IMG")" || exit 1

  local DIR="$THEMES_DIR/$NAME" slug
  mkdir -p "$DIR/backgrounds"
  echo "$COLORS_TOML" >"$DIR/colors.toml"
  printf 'TAGLINE=""\n' >"$DIR/theme.conf"
  slug="$(image_slug "$IMG")"
  cp "$IMG" "$DIR/backgrounds/1-$slug"

  echo "themes/$NAME/colors.toml:"
  echo "$COLORS_TOML"
  if [ -t 1 ]; then
    echo
    swatches "$DIR"
    printf '\n'
  fi
  echo "next: eyeball the palette, edit colors.toml if a slot is off, add a TAGLINE to theme.conf, then: theme $NAME"
}

cmd_adopt() {
  [ "${1:-}" = "-h" ] || [ "${1:-}" = "--help" ] && { usage; exit 0; }
  [ $# -eq 1 ] || { usage >&2; exit 2; }
  local IMG="$1" tmp matches best score dest
  command -v magick >/dev/null 2>&1 || die "adopt needs ImageMagick (brew install imagemagick / pacman -S imagemagick)"
  [ -f "$IMG" ] || die "no such image: $IMG"

  tmp="$(mktemp)"
  palette_from_image "$IMG" >"$tmp" || { rm -f "$tmp"; exit 1; }
  matches="$(adopt_matches "$tmp")" || { rm -f "$tmp"; exit 1; }
  rm -f "$tmp"

  best="$(printf '%s\n' "$matches" | awk 'NR == 1 { print $1 }')"
  score="$(printf '%s\n' "$matches" | awk 'NR == 1 { print $2 }')"
  [ -n "$best" ] && [ -n "$score" ] || die "no themes found"

  if [ "$score" -gt 60 ]; then
    printf 'theme: closest: %s\n' "$(printf '%s\n' "$matches" | awk 'NR <= 3 { out = out sep $1 " (" $2 ")"; sep = ", " } END { print out }')" >&2
    die "no close match; use: theme from-image <new-name> $IMG" 2
  fi

  dest="$(add_wallpaper "$best" "$IMG")"
  echo "adopted: $dest -> $best (score $score)"
}

# ── The switch ───────────────────────────────────────────────────

lock() {
  command -v flock >/dev/null 2>&1 || return 0 # macOS has no flock; switches there are by hand anyway
  exec 9>"$STATE/.lock"
  flock 9
}

stage() { # NAME MODE -> $STATE/next-theme: the pack's files, then templates for what it lacks
  local pack="$THEMES_DIR/$1" next="$STATE/next-theme" f
  rm -rf "$next"
  mkdir -p "$next"
  for f in "$pack"/*; do
    [ -e "$f" ] || continue
    case "$(basename "$f")" in
      backgrounds) ln -s "$f" "$next/backgrounds" ;;
      *) cp -R "$f" "$next/" ;;
    esac
  done
  "$COLOR" -f "$pack/colors.toml" --name "$1" --mode "$2" --render "$next" "$TEMPLATES_DIR"/*.tpl
}

swap() { # next-theme becomes theme; consumers never see an empty directory
  rm -rf "$STATE/theme.old"
  [ -e "$STATE/theme" ] && mv "$STATE/theme" "$STATE/theme.old"
  mv "$STATE/next-theme" "$STATE/theme"
  rm -rf "$STATE/theme.old"
}

apply() { # NAME  BG (1-based index | image path | keep)
  local name="$1" bg_spec="${2:-1}" pack="$THEMES_DIR/$1"
  [ -f "$pack/colors.toml" ] || die "unknown theme '$name'. Available:
$(list_themes)"

  # wallpaper choice, validated before anything changes
  local -a bgs=()
  local wall="" b
  while IFS= read -r b; do [ -n "$b" ] && bgs+=("$b"); done < <(backgrounds "$name")
  case "$bg_spec" in
    keep)
      wall="$(readlink "$STATE/background" 2>/dev/null || true)"
      [ -f "$wall" ] || wall="${bgs[0]:-}"
      ;;
    *[!0-9]*)
      [ -f "$bg_spec" ] || die "no such image: $bg_spec"
      wall="$(cd "$(dirname "$bg_spec")" && pwd)/$(basename "$bg_spec")"
      ;;
    *)
      if [ ${#bgs[@]} -gt 0 ]; then
        [ "$bg_spec" -ge 1 ] && [ "$bg_spec" -le ${#bgs[@]} ] || die "$name has ${#bgs[@]} wallpaper(s), no number $bg_spec" 2
        wall="${bgs[$((bg_spec - 1))]}"
      fi
      ;;
  esac

  local TAGLINE="" THEME_MODE="" mode
  # shellcheck disable=SC1091
  [ -f "$pack/theme.conf" ] && source "$pack/theme.conf"
  mode="$("$COLOR" -f "$pack/colors.toml" ${THEME_MODE:+--mode "$THEME_MODE"} mode)"

  mkdir -p "$STATE"
  lock
  stage "$name" "$mode"
  swap
  echo "$name" >"$STATE/theme.name"
  echo "$mode" >"$STATE/mode"
  # one write: quickshell watches this file and re-reads it on change
  local json; json="$("$COLOR" -f "$STATE/theme/colors.toml" --name "$name" --mode "$mode" --json)"
  printf '%s\n' "$json" >"$STATE/colors.json"
  [ -n "$wall" ] && ln -sfn "$wall" "$STATE/background"

  reload_apps "$name" "$mode" "$wall"
  finale "$name" "$mode" "$TAGLINE"
  plymouth_hint
}

# ── Consumers ────────────────────────────────────────────────────
# everything here reports to stderr; stdout gets the finale only

refresh_browsers() {
  if $IS_MAC; then
    local app
    for app in Chromium Helium; do
      pgrep -x "$app" >/dev/null 2>&1 || continue
      open -gj -a "$app" --args --refresh-platform-policy --no-startup-window >/dev/null 2>&1 || true
    done
  else
    pgrep -x chromium >/dev/null 2>&1 && command -v chromium >/dev/null 2>&1 &&
      chromium --refresh-platform-policy --no-startup-window >/dev/null 2>&1 || true
    pgrep -x helium >/dev/null 2>&1 && command -v helium-browser >/dev/null 2>&1 &&
      helium-browser --refresh-platform-policy --no-startup-window >/dev/null 2>&1 || true
  fi
}

install_policy_link() { # TARGET LINK — never replace another policy
  local target="$1" link="$2"
  if [ -L "$link" ]; then
    [ "$(readlink "$link")" = "$target" ] || die "$link already links elsewhere; refusing to replace it"
    return
  fi
  [ ! -e "$link" ] || die "$link already exists; refusing to replace it"
  sudo ln -s "$target" "$link" || die "could not install $link"
  [ "$(readlink "$link" 2>/dev/null)" = "$target" ] || die "$link was not installed"
}

cmd_browser_install() {
  local name dir target id
  name="$(current_theme)"
  [ "$name" != none ] || die "no theme set yet"
  [ -f "$STATE/theme/browser-policy.json" ] || apply "$name" keep

  if $IS_MAC; then
    dir="/Library/Managed Preferences/$(id -un)"
    [ -d "$dir" ] || sudo install -d -m 0755 "$dir" || die "could not create $dir"
    target="$STATE/theme/browser-policy.plist"
    for id in org.chromium.Chromium net.imput.helium; do
      install_policy_link "$target" "$dir/$id.plist"
    done
  else
    dir=/etc/chromium/policies/managed
    [ -d "$dir" ] || sudo install -d -m 0755 "$dir" || die "could not create $dir"
    install_policy_link "$STATE/theme/browser-policy.json" "$dir/nisi-theme.json"
  fi

  refresh_browsers
  echo "browser policy: Chromium + Helium (managed)"
}

reload_apps() { # NAME MODE WALL
  local name="$1" mode="$2" wall="$3" T="$STATE/theme"

  # terminals re-read their config on a signal; wezterm watches a file
  pkill -USR2 ghostty 2>/dev/null || true
  pkill -USR1 kitty 2>/dev/null || true
  [ -d "$HOME/.config/wezterm" ] && [ -f "$T/wezterm.lua" ] && cp "$T/wezterm.lua" "$HOME/.config/wezterm/theme-current.lua"

  tmux has-session 2>/dev/null && tmux source-file "$HOME/.config/tmux/tmux.conf" || true
  nvim_reload
  btop_point
  install_agent_themes
  starship_palette

  if $IS_MAC; then
    mac_appearance "$mode"
    pgrep -x sketchybar >/dev/null 2>&1 && sketchybar --reload || true
    brew services restart borders >/dev/null 2>&1 || true
    [ -n "$wall" ] && mac_wallpaper "$wall"
    if [ -f "$T/slack.txt" ]; then
      pbcopy <"$T/slack.txt"
      echo "slack theme on clipboard — Slack > Settings > Appearance > Custom theme > Import, then paste" >&2
    fi
  else
    linux_gtk "$mode"
    if [ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]; then
      hypr_borders "$T" || hyprctl reload >/dev/null 2>&1 || true
      command -v qs >/dev/null 2>&1 && qs ipc call theme reload >/dev/null 2>&1 || true
    fi
    [ -n "$wall" ] && paint_wallpaper
    ensure_desktop_entries
  fi
  refresh_browsers
  thumbs_background
}

nvim_reload() { # every running nvim re-applies aether from the rendered palette
  local dirs=("${TMPDIR:-/tmp}") d
  [ -n "${XDG_RUNTIME_DIR:-}" ] && dirs=("$XDG_RUNTIME_DIR" "${dirs[@]}")
  for d in "${dirs[@]}"; do find "$d" -maxdepth 4 -type s -name 'nvim.*.0' 2>/dev/null; done |
    while read -r sock; do
      nvim --server "$sock" --remote-expr "execute('lua if _G.apply_named_theme then _G.apply_named_theme() end')" >/dev/null 2>&1 || true
    done || true
}

btop_point() { # btop.conf names the rendered theme once; btop rewrites the file on exit but keeps this line
  local conf="$HOME/.config/btop/btop.conf" want="color_theme = \"$STATE/theme/btop.theme\"" tmp
  mkdir -p "$HOME/.config/btop"
  if [ ! -f "$conf" ]; then
    echo "$want" >"$conf"
  elif ! grep -qxF "$want" "$conf"; then
    tmp="$(mktemp)"
    if grep -q '^color_theme = ' "$conf"; then
      sed "s|^color_theme = .*|$want|" "$conf" >"$tmp"
    else
      cat "$conf" >"$tmp"; echo "$want" >>"$tmp"
    fi
    mv "$tmp" "$conf"
  fi
  pgrep -x btop >/dev/null 2>&1 && echo "theme: btop is running — quit and reopen it, it reads the theme at launch" >&2 || true
}

install_agent_themes() { # pi + claude read one fixed theme, "system", rewritten on every switch
  # (claude hot-reloads that file, so settings.json never has to change again,
  # and the standalone themes in home/.claude/themes keep their names)
  local T="$STATE/theme" f
  mkdir -p "$HOME/.claude/themes" "$HOME/.pi/agent/themes"
  # standalone (non-pack) themes stay available in the live dirs; no-op when those dirs are the repo's
  cp -n "$DOTFILES"/home/.claude/themes/*.json "$HOME/.claude/themes/" 2>/dev/null || true
  cp -n "$DOTFILES"/home/.pi/agent/themes/*.json "$HOME/.pi/agent/themes/" 2>/dev/null || true
  install_json "$T/claude.json" "$HOME/.claude/themes/system.json"
  install_json "$T/pi.json" "$HOME/.pi/agent/themes/system.json"
  for f in "$HOME/.claude/settings.json" "$DOTFILES/home/.claude/settings.json"; do set_json_theme "$f" "custom:system"; done
  for f in "$HOME/.pi/agent/settings.json" "$DOTFILES/home/.pi/agent/settings.json"; do set_json_theme "$f" "system"; done
}

install_json() { # SRC DEST, atomically (claude watches the file; pi reads it at launch)
  [ -f "$1" ] || return 0
  local tmp; tmp="$(mktemp "$(dirname "$2")/.system.XXXXXX")"
  cp "$1" "$tmp" && mv "$tmp" "$2"
}

set_json_theme() { # FILE VALUE
  local file="$1" value="$2" tmp
  [ -f "$file" ] || return 0
  command -v jq >/dev/null 2>&1 || { echo "theme: jq missing — $file theme not updated" >&2; return 0; }
  [ "$(jq -r '.theme // ""' "$file")" = "$value" ] && return 0
  tmp="$(mktemp)"
  jq --arg t "$value" '.theme = $t' "$file" >"$tmp" && mv "$tmp" "$file"
}

# Starship has no include directive, unlike kitty (include) and ghostty
# (config-file), so it cannot be pointed at a fragment in the state dir. This
# used to splice the palette into config/starship.toml itself, which made that
# tracked dotfile the one consumer a theme switch rewrote: the repo went dirty
# on every switch and any commit picked up whichever pack happened to be active.
#
# Instead the whole config is rendered here, source file plus the pack's
# palette, and .zshrc exports STARSHIP_CONFIG pointing at the result. That puts
# starship back on the same footing as every other app: tracked source, rendered
# artifact in the state dir, nothing in the repo moving.
#
# Runs after swap(), so $T is already the newly swapped-in directory and this
# lands in the pack it belongs to.
starship_palette() { # config/starship.toml + the pack's palette -> state dir
  local cfg="$DOTFILES/config/starship.toml" T="$STATE/theme" tmp
  [ -f "$T/starship.palette" ] && [ -f "$cfg" ] || return 0
  tmp="$(mktemp)"
  {
    awk '/^\[palettes\./{skip=1; next} /^\[/{skip=0} !skip' "$cfg" | sed 's/^palette = ".*"/palette = "theme"/' | sed -e :a -e '/^\n*$/{$d;N;ba' -e '}'
    printf '\n[palettes.theme]\n'
    cat "$T/starship.palette"
  } >"$tmp"
  if cmp -s "$tmp" "$T/starship.toml"; then rm -f "$tmp"; else mv "$tmp" "$T/starship.toml"; fi
}

mac_appearance() { # dark|light — the pack decides, the system follows
  local dark=false; [ "$1" = dark ] && dark=true
  osascript -e "tell application \"System Events\" to tell appearance preferences to set dark mode to $dark" >/dev/null 2>&1 ||
    echo "theme: could not set macOS appearance (Automation permission for System Events?)" >&2
}

mac_wallpaper() { # path stays an ARGUMENT, never spliced into script text
  if osascript - "$1" >/dev/null 2>&1 <<'APPLESCRIPT'; then
on run argv
  tell application "System Events" to tell every desktop to set picture to (item 1 of argv)
end run
APPLESCRIPT
    echo "wallpaper: $(basename "$1") (applies in a few seconds)" >&2
  else
    echo "theme: wallpaper failed (Automation permission for System Events?)" >&2
  fi
}

# Borders are all Hyprland takes from a theme switch, and `hyprctl eval` sets
# them in place. `hyprctl reload` also does the job but re-reads the whole
# config, which re-applies hyprland.lua's monitor line. On battery that drags
# the panel off the 60 Hz PowerMode.qml put it at, back to the config's
# "preferred" of 120, and the panel blanks for the modeset; panel-hz then puts
# it back, blanking a second time. Neither blank has anything to do with
# colours, and a theme switch is the one thing that made it happen on every
# switch rather than only on a manual reload.
#
# Hyprland 0.56's Lua parser rejects `hyprctl keyword`, so eval calling the
# same hl.config() the rendered file uses is the way in, the same route
# bin/panel-hz takes for hl.monitor. `hyprctl eval` exits non-zero on a Lua
# error, so the fallback is honest. Read the Lua values as expressions so both
# strings and the default active gradient apply without a full reload.
hypr_borders() { # rendered theme dir -> 0 if the colours went in without a reload
  local f="$1/hyprland.lua" active inactive
  [ -f "$f" ] || return 1
  active="$(sed -n 's/^local active = \(.*\)$/\1/p' "$f")"
  inactive="$(sed -n 's/^local inactive = \(.*\)$/\1/p' "$f")"
  [ -n "$active" ] && [ -n "$inactive" ] || return 1
  hyprctl eval "local active = $active; local inactive = $inactive; hl.config({ general = { col = { active_border = active, inactive_border = inactive } }, group = { col = { border_active = active, border_inactive = inactive } } })" >/dev/null 2>&1
}

linux_gtk() { # dark|light: GTK3/4 + libadwaita follow color-scheme; icons if the pack names an installed set
  command -v gsettings >/dev/null 2>&1 && [ -n "${DBUS_SESSION_BUS_ADDRESS:-}" ] || return 0
  if [ "$1" = light ]; then
    gsettings set org.gnome.desktop.interface color-scheme prefer-light
    gsettings set org.gnome.desktop.interface gtk-theme Adwaita
  else
    gsettings set org.gnome.desktop.interface color-scheme prefer-dark
    gsettings set org.gnome.desktop.interface gtk-theme Adwaita-dark
  fi
  local icons; icons="$(cat "$STATE/theme/icons.theme" 2>/dev/null || true)"
  [ -n "$icons" ] || return 0
  local d
  for d in /usr/share/icons "$HOME/.local/share/icons" "$HOME/.icons"; do
    if [ -d "$d/$icons" ]; then gsettings set org.gnome.desktop.interface icon-theme "$icons"; return 0; fi
  done
}

paint_wallpaper() { # $STATE/background is the source of truth; the daemon re-reads it
  if command -v awww >/dev/null 2>&1 && awww query >/dev/null 2>&1; then
    awww img "$STATE/background" --transition-type random --transition-duration 1.2 >/dev/null 2>&1 || true
  elif command -v swww >/dev/null 2>&1 && swww query >/dev/null 2>&1; then
    swww img "$STATE/background" --transition-type random --transition-duration 1.2 >/dev/null 2>&1 || true
  elif systemctl --user is-active --quiet hyprpaper 2>/dev/null; then
    # hyprpaper 0.8 has no set-wallpaper IPC; hyprpaper.conf points at the symlink, so a restart repaints
    systemctl --user restart hyprpaper
  elif pgrep -x hyprpaper >/dev/null 2>&1; then
    pkill -x hyprpaper
    (setsid hyprpaper >/dev/null 2>&1 &)
  else
    echo "theme: no wallpaper daemon running (awww, swww, or hyprpaper)" >&2
  fi
  echo "wallpaper: $(basename "$(readlink "$STATE/background")")" >&2
}

finale() { # NAME MODE TAGLINE
  if [ -t 1 ]; then
    swatches "$STATE/theme"
    printf '\n'
    name_painted "$STATE/theme" "$1"
    [ -n "$3" ] && printf '  \033[2m%s\033[0m' "$3"
    printf '  \033[2m(%s)\033[0m\n' "$2"
  else
    echo "theme: $1 ($2)"
    if ! $IS_MAC && command -v notify-send >/dev/null 2>&1; then
      notify-send -a theme -t 2500 "theme: $1" "$3" 2>/dev/null || true
    fi
  fi
}

cmd_bg() { # next|prev|N|path — wallpaper only
  local name; name="$(current_theme)"
  [ "$name" != none ] || die "no theme set yet"
  local -a bgs=()
  local b cur wall="" idx=-1 i n
  while IFS= read -r b; do [ -n "$b" ] && bgs+=("$b"); done < <(backgrounds "$name")
  n=${#bgs[@]}
  case "${1:-next}" in
    next | prev)
      [ "$n" -gt 0 ] || die "$name has no wallpapers"
      cur="$(readlink "$STATE/background" 2>/dev/null || true)"
      for i in "${!bgs[@]}"; do [ "${bgs[$i]}" = "$cur" ] && idx=$i; done
      [ "${1:-next}" = next ] && idx=$(((idx + 1) % n)) || idx=$(((idx - 1 + n) % n))
      wall="${bgs[$idx]}"
      ;;
    *[!0-9]*)
      [ -f "$1" ] || die "no such image: $1"
      wall="$(cd "$(dirname "$1")" && pwd)/$(basename "$1")"
      ;;
    *)
      [ "$1" -ge 1 ] && [ "$1" -le "$n" ] || die "$name has $n wallpaper(s), no number $1" 2
      wall="${bgs[$(($1 - 1))]}"
      ;;
  esac
  ln -sfn "$wall" "$STATE/background"
  if $IS_MAC; then mac_wallpaper "$wall"; else paint_wallpaper; fi
  if [ ! -t 1 ] && ! $IS_MAC; then
    notify-send -a theme -t 2000 "wallpaper" "$(basename "$wall")" 2>/dev/null || true
  fi
}

# ── The overlay picker (config/quickshell/ThemePicker.qml) ───────
# The shell draws it; this end feeds it rows and caches the thumbnails.

cmd_picker() { # themes|backgrounds
  local kind="${1:-themes}"
  if command -v qs >/dev/null 2>&1 && qs ipc call picker open "$kind" >/dev/null 2>&1; then
    return 0
  fi
  [ "$kind" = themes ] || die "the wallpaper picker needs the quickshell overlay; try: theme bg next"
  cmd_menu
}

file_sig() { if $IS_MAC; then stat -f '%z:%m' "$1"; else stat -Lc '%s:%Y' "$1"; fi; }
md5str() { if $IS_MAC; then md5 -q -s "$1"; else printf '%s' "$1" | md5sum | cut -d' ' -f1; fi; }
thumb_path() { # image -> where its thumbnail lives (keyed on path + size + mtime, so edits miss)
  local sig; sig="$(file_sig "$1" 2>/dev/null)" || return 1
  printf '%s/thumbs/%s.jpg' "$CACHE" "$(md5str "$1	$sig")"
}
thumb_for() { # image -> its cached thumbnail, else the image itself
  local t; t="$(thumb_path "$1" 2>/dev/null || true)"
  if [ -n "$t" ] && [ -f "$t" ]; then printf '%s' "$t"; else printf '%s' "$1"; fi
}

humanize() { # "0-winding-road.webp" -> "Winding Road", "tokyo-night" -> "Tokyo Night"
  local s="${1##*/}"; s="${s%.*}"; s="${s#[0-9]*-}"
  printf '%s' "$s" | tr '_-' '  ' | awk '{ for (i = 1; i <= NF; i++) $i = toupper(substr($i, 1, 1)) substr($i, 2) } 1'
}
json_str() { local s="${1//\\/\\\\}"; s="${s//\"/\\\"}"; printf '"%s"' "$s"; }
swatch_json() { # DIR -> "#..","#..",...
  local dir="$1" c out=""
  for c in "$(hex accent blue "$dir")" "$(hex red color1 "$dir")" "$(hex green color2 "$dir")" \
    "$(hex yellow color3 "$dir")" "$(hex blue color4 "$dir")" "$(hex magenta color5 "$dir")" "$(hex cyan color6 "$dir")"; do
    [ -n "$c" ] && out+="${out:+,}\"$c\""
  done
  printf '%s' "$out"
}

cmd_rows() { # themes|backgrounds -> JSON rows for the picker
  local kind="${1:-themes}" sep="" cur t img
  printf '['
  if [ "$kind" = backgrounds ]; then
    t="$(current_theme)"
    cur="$(readlink "$STATE/background" 2>/dev/null || true)"
    while IFS= read -r img; do
      [ -n "$img" ] || continue
      printf '%s{"name":%s,"label":%s,"image":%s,"tagline":%s,"swatches":[],"current":%s}' "$sep" \
        "$(json_str "$img")" "$(json_str "$(humanize "$img")")" "$(json_str "$(thumb_for "$img")")" \
        "$(json_str "$t")" "$([ "$img" = "$cur" ] && echo true || echo false)"
      sep=","
    done < <(backgrounds "$t")
  else
    cur="$(current_theme)"
    while IFS= read -r t; do
      img="$(backgrounds "$t" | head -1)"
      printf '%s{"name":%s,"label":%s,"image":%s,"tagline":%s,"swatches":[%s],"current":%s}' "$sep" \
        "$(json_str "$t")" "$(json_str "$(humanize "$t")")" "$(json_str "$([ -n "$img" ] && thumb_for "$img")")" \
        "$(json_str "$(tagline "$THEMES_DIR/$t")")" "$(swatch_json "$THEMES_DIR/$t")" "$([ "$t" = "$cur" ] && echo true || echo false)"
      sep=","
    done < <(list_themes)
  fi
  printf ']\n'
  thumbs_background # whatever was missing is there next time
}

make_thumb() { # image: 1440x900 centre crop (the 720x450 card at scale 1.6, sharp)
  local out tmp
  out="$(thumb_path "$1")" || return 0
  [ -f "$out" ] && return 0
  tmp="$out.$$.tmp.jpg"
  if magick "$1[0]" -auto-orient -resize '1440x900^' -gravity center -extent 1440x900 -strip -quality 82 "$tmp" 2>/dev/null; then
    mv -f "$tmp" "$out"
  else
    rm -f "$tmp"
  fi
}

cmd_thumbs() { # every pack's first wallpaper first (the theme picker), then the current theme's, then the rest
  command -v magick >/dev/null 2>&1 || die "thumbs needs ImageMagick"
  mkdir -p "$CACHE/thumbs"
  if command -v flock >/dev/null 2>&1; then
    exec 8>"$CACHE/thumbs/.lock"
    flock -n 8 || return 0 # one generator at a time
  fi
  local t img
  {
    for t in $(list_themes); do backgrounds "$t" | head -1; done
    backgrounds "$(current_theme)"
    for t in $(list_themes); do backgrounds "$t"; done
  } | awk '!seen[$0]++' | while IFS= read -r img; do
    [ -n "$img" ] && make_thumb "$img"
  done
}

thumbs_background() {
  command -v magick >/dev/null 2>&1 || return 0
  (nohup "$DOTFILES/bin/theme" thumbs >/dev/null 2>&1 </dev/null &)
}

ensure_desktop_entries() { # wofi's drun list gets "Theme" and "Wallpaper"; both open the overlay
  local dir="${XDG_DATA_HOME:-$HOME/.local/share}/applications"
  mkdir -p "$dir"
  write_desktop "$dir/theme-picker.desktop" Theme "Switch the desktop theme" preferences-desktop-theme "\"$DOTFILES/bin/theme\" picker themes"
  write_desktop "$dir/theme-wallpaper.desktop" Wallpaper "Pick a wallpaper for the current theme" preferences-desktop-wallpaper "\"$DOTFILES/bin/theme\" picker backgrounds"
}

write_desktop() { # path name comment icon exec — only touched when the content changes
  local tmp; tmp="$(mktemp)"
  cat >"$tmp" <<EOF
[Desktop Entry]
Type=Application
Name=$2
Comment=$3
Icon=$4
Exec=$5
Terminal=false
Categories=Settings;DesktopSettings;
Keywords=theme;colors;wallpaper;
EOF
  if cmp -s "$tmp" "$1"; then rm -f "$tmp"; else mv "$tmp" "$1"; fi
}

# ── Args ─────────────────────────────────────────────────────────

[ "${1:-}" = set ] && shift

# ── Boot splash (plymouth) ───────────────────────────────────────
# Rendered on every switch like everything else, installed only on request:
# installing means sudo plus a full mkinitcpio -P, which has no place inside a
# theme switch that otherwise finishes in under a second. One fixed theme name,
# rewritten in place, the same shape as the agents' "system" theme.
PLYMOUTH_NAME=nisi
PLYMOUTH_DIR="/usr/share/plymouth/themes/$PLYMOUTH_NAME"

plymouth_current() { # is the installed splash exactly the rendered one?
  [ -f "$PLYMOUTH_DIR/$PLYMOUTH_NAME.script" ] &&
    cmp -s "$STATE/theme/plymouth.script" "$PLYMOUTH_DIR/$PLYMOUTH_NAME.script" &&
    cmp -s "$STATE/theme/plymouth.plymouth" "$PLYMOUTH_DIR/$PLYMOUTH_NAME.plymouth" &&
    [ "$(plymouth-set-default-theme 2>/dev/null)" = "$PLYMOUTH_NAME" ]
}

plymouth_hint() { # one line after a switch, only once a themed splash exists and now lags
  $IS_MAC && return 0
  [ -f "$PLYMOUTH_DIR/$PLYMOUTH_NAME.script" ] || return 0
  plymouth_current && return 0
  echo "boot splash still shows the previous theme: theme plymouth (rebuilds the initramfs)"
}

cmd_plymouth() {
  $IS_MAC && die "the boot splash is Linux only"
  [ "$(current_theme)" != none ] || die "no theme set yet"
  local T="$STATE/theme"
  [ -f "$T/plymouth.script" ] && [ -f "$T/plymouth.plymouth" ] ||
    die "nothing rendered for plymouth; run: theme refresh"
  command -v plymouth-set-default-theme >/dev/null 2>&1 || die "plymouth is not installed"
  if plymouth_current; then
    echo "boot splash already matches $(current_theme)"
    return 0
  fi
  echo "installing the $(current_theme) boot splash and rebuilding the initramfs (sudo)"
  sudo install -D -m 0644 "$T/plymouth.plymouth" "$PLYMOUTH_DIR/$PLYMOUTH_NAME.plymouth" &&
    sudo install -D -m 0644 "$T/plymouth.script" "$PLYMOUTH_DIR/$PLYMOUTH_NAME.script" &&
    sudo plymouth-set-default-theme "$PLYMOUTH_NAME" &&
    sudo mkinitcpio -P || die "boot splash install failed (see the error above); nothing later in the chain ran"
  cat <<TXT
done. Shows on the next boot.
If it misrenders: at the boot menu press e, delete 'splash', Enter. That boots
with the plain console prompt; then \`sudo plymouth-set-default-theme bgrt &&
sudo mkinitcpio -P\` puts the stock splash back.
TXT
}

case "${1:-}" in
  -h | --help | help) usage; exit 0 ;;
  list | -l | --list)
    if [ -t 1 ]; then
      list_themes | while read -r t; do
        printf '%s\033[1m%s\033[0m \033[2m%s\033[0m\n' "$(swatches "$THEMES_DIR/$t")" "$t" "$(tagline "$THEMES_DIR/$t")"
      done
    else
      list_themes
    fi
    ;;
  current) current_theme ;;
  next | prev) apply "$(neighbour_theme "$1")" 1 ;;
  bg) shift; cmd_bg "$@" ;;
  menu) cmd_menu ;;
  picker) cmd_picker "${2:-themes}" ;;
  thumbs) cmd_thumbs ;;
  _rows) cmd_rows "${2:-themes}" ;;
  refresh) [ "$(current_theme)" != none ] || die "no theme set yet"; apply "$(current_theme)" keep ;;
  browser) [ "${2:-}" = install ] && [ $# -eq 2 ] || die "usage: theme browser install" 2; cmd_browser_install ;;
  plymouth) cmd_plymouth ;;
  from-image) shift; cmd_from_image "$@" ;;
  adopt) shift; cmd_adopt "$@" ;;
  _preview-theme) preview_theme "$2" ;;
  _preview-bg) preview_bg "$2" "$3" ;;
  "") pick_theme ;;
  -*) usage >&2; die "unknown flag '$1'" 2 ;;
  *)
    case "${2:-1}" in *[!0-9]* | "") die "wallpaper must be a number, got '${2:-}'" 2 ;; esac
    apply "$1" "${2:-1}"
    ;;
esac
