#!/usr/bin/env bash
# theme — the whole desktop theme, one command.
#
# The ~/.config/theme/current symlink swap IS the switch; the rest of this
# file makes running apps re-read it (ghostty, wezterm, nvim, tmux,
# sketchybar, borders, btop, wallpaper, pi, claude code, starship, slack).
#
# ponytail: appearance flips after a switch don't re-run this — re-run by hand.

set -euo pipefail

# Guard: this script is macOS-only (uses osascript, brew, pbcopy, etc.)
if [[ "$(uname -s)" != "Darwin" ]]; then
  echo "theme: this script is macOS-only. On Omarchy (Linux) use: omarchy theme set <name>" >&2
  exit 1
fi

SOURCE="${BASH_SOURCE[0]}"
[ -L "$SOURCE" ] && SOURCE="$(readlink "$SOURCE")"
DOTFILES="$(cd "$(dirname "$SOURCE")/.." && pwd)"
THEMES_DIR="$DOTFILES/themes"
STATE_DIR="$HOME/.config/theme"

list_themes() { for t in "$THEMES_DIR"/*/; do basename "$t"; done; }
current_theme() { basename "$(readlink "$STATE_DIR/current" 2>/dev/null || echo none)"; }

usage() {
  cat <<'USAGE'
theme — the whole desktop theme, one command

usage:
  theme                       pick a theme (and wallpaper) interactively
  theme set <theme> [bg]      switch; bg = Nth wallpaper (default 1)
  theme next                  cycle to the next theme
  theme list                  list themes with their palettes
  theme current               print the active theme
  theme from-image <name> <image>
                              grow a new pack from a wallpaper (writes
                              colors.toml + backgrounds/, prints palette)
  theme -h, --help            this

switches: ghostty, wezterm, nvim, tmux, sketchybar, borders, btop,
          wallpaper, pi, claude code, starship, slack (clipboard)

pi and claude apply on next launch; btop too; the ghostty dock icon
needs an app restart; the wallpaper repaints a few seconds after.
USAGE
}

# ── Palette helpers ─────────────────────────────────────────────

hex() { grep -E "^$1 = " "$2/colors.toml" 2>/dev/null | head -1 | cut -d'"' -f2; }
rgb() { local h="${1#\#}"; printf '%d;%d;%d' "0x${h:0:2}" "0x${h:2:2}" "0x${h:4:2}"; }

swatches() { # theme dir -> truecolor ██ row (accent + color1-6)
  local dir="$1" key c out=""
  for key in accent color1 color2 color3 color4 color5 color6; do
    c="$(hex "$key" "$dir")"
    [ -n "$c" ] && out+=$'\033[38;2;'"$(rgb "$c")"$'m██\033[0m '
  done
  printf '%s' "$out"
}

tagline() { (source "$1/theme.conf" 2>/dev/null; printf '%s' "${TAGLINE:-}"); }

name_painted() { # theme name in its accent color
  printf '\033[1m\033[38;2;%sm%s\033[0m' "$(rgb "$(hex accent "$1")")" "$2"
}

# ── Interactive picking (fzf) ───────────────────────────────────

preview_theme() { # fzf --preview for theme names
  local dir="$THEMES_DIR/$1"
  [ -d "$dir" ] || exit 0
  name_painted "$dir" "$1"
  local t; t="$(tagline "$dir")"
  [ -n "$t" ] && printf '  \033[2m%s\033[0m' "$t"
  printf '\n%s\n' "$(swatches "$dir")"
  local n; n="$(ls "$dir"/backgrounds/* 2>/dev/null | wc -l | tr -d ' ')"
  printf '\033[2m%s wallpaper(s)\033[0m\n' "$n"
}

preview_bg() { # fzf --preview for a theme's Nth wallpaper
  local img; img="$(ls "$THEMES_DIR/$1"/backgrounds/* 2>/dev/null | sed -n "$2p")"
  [ -n "$img" ] || exit 0
  printf '\033[1m%s\033[0m\n' "$(basename "$img")"
  local kitten=/Applications/kitty.app/Contents/MacOS/kitten
  if [ -x "$kitten" ] && [ "${TERM_PROGRAM:-}" = ghostty -o "${TERM_PROGRAM:-}" = kitty ]; then
    # kitty graphics protocol (ghostty speaks it); must bypass fzf's capture
    "$kitten" icat --clear --transfer-mode=memory --stdin=no --scale-up \
      --place "${FZF_PREVIEW_COLUMNS:-80}x$(( ${FZF_PREVIEW_ROWS:-20} - 2 ))@0x2" "$img" >/dev/tty 2>/dev/null || true
  elif command -v img2txt >/dev/null 2>&1; then
    img2txt -W "${FZF_PREVIEW_COLUMNS:-80}" -H "$(( ${FZF_PREVIEW_ROWS:-20} - 2 ))" "$img" 2>/dev/null || true
  fi
}

pick_theme() {
  command -v fzf >/dev/null 2>&1 && [ -t 0 ] || {
    list_themes
    echo "theme: pass a name, e.g. theme set $(current_theme)" >&2
    exit 2
  }
  local name n bg=1
  name="$(list_themes | fzf --prompt='theme ❯ ' --reverse --height=~60% \
    --preview="'$DOTFILES'/bin/theme _preview-theme {}" \
    --preview-window='right,50%,border-left')" || exit 130
  [ -n "$name" ] || exit 130
  n="$(ls "$THEMES_DIR/$name"/backgrounds/* 2>/dev/null | wc -l | tr -d ' ')"
  if [ "$n" -gt 1 ]; then
    bg="$(seq 1 "$n" | fzf --prompt='wallpaper ❯ ' --reverse --height=~40% \
      --preview="'$DOTFILES'/bin/theme _preview-bg $name {}" \
      --preview-window='right,60%,border-left')" || exit 130
    [ -n "$bg" ] || exit 130
  fi
  NAME="$name"
  BG_INDEX="$bg"
}

next_theme() {
  local cur themes=() i
  cur="$(current_theme)"
  while read -r t; do themes+=("$t"); done < <(list_themes)
  for i in "${!themes[@]}"; do
    [ "${themes[$i]}" = "$cur" ] && { echo "${themes[$(((i + 1) % ${#themes[@]}))]}"; return; }
  done
  echo "${themes[0]}"
}

# ── from-image: extract a palette from a wallpaper ─────────────
# ponytail: heuristic hue mapping, not a perceptual model. If a slot
# looks off, edit colors.toml by hand — that file is the contract.

cmd_from_image() {
  [ "${1:-}" = "-h" ] || [ "${1:-}" = "--help" ] && { usage; exit 0; }
  [ $# -eq 2 ] || { usage >&2; exit 2; }
  local NAME="$1" IMG="$2"
  command -v magick >/dev/null 2>&1 || { echo "theme: from-image needs ImageMagick (brew install imagemagick)" >&2; exit 1; }
  [ -f "$IMG" ] || { echo "theme: no such image: $IMG" >&2; exit 1; }
  [ -d "$THEMES_DIR/$NAME" ] && { echo "theme: themes/$NAME already exists" >&2; exit 1; }

  local PYSCRIPT COLORS_TOML
  PYSCRIPT="$(cat <<'PYEOF'
import colorsys, re, sys

name = sys.argv[1]
entries = []  # (count, r, g, b) 0-255
for line in sys.stdin:
    m = re.match(r"\s*(\d+):.*?#([0-9A-Fa-f]{6})", line)
    if m:
        h = m.group(2)
        entries.append((int(m.group(1)), int(h[0:2], 16), int(h[2:4], 16), int(h[4:6], 16)))
if not entries:
    sys.exit("theme: no colors extracted")

def hls(r, g, b):
    return colorsys.rgb_to_hls(r / 255, g / 255, b / 255)  # h, l, s

def rgb_hex(r, g, b):
    return "#%02X%02X%02X" % (max(0, min(255, round(r))), max(0, min(255, round(g))), max(0, min(255, round(b))))

def mix(c, t, f):  # toward t by f
    return tuple(a + (b - a) * f for a, b in zip(c, t))

def shift_hue(c, target_deg):
    h, l, s = hls(*c)
    r, g, b = colorsys.hls_to_rgb(target_deg / 360, max(0.3, min(0.7, l)), max(0.4, s))
    return (r * 255, g * 255, b * 255)

C = [(n, (r, g, b)) for n, r, g, b in entries]

def best(pred, fallback_key):
    pool = [(n, c) for n, c in C if pred(*hls(*c))]
    if pool:
        return max(pool)[1]
    return max(C, key=lambda nc: fallback_key(*hls(*nc[1])))[1]

bg = best(lambda h, l, s: l < 0.28, lambda h, l, s: -l)
fg = best(lambda h, l, s: l > 0.72, lambda h, l, s: l)
if hls(*fg)[1] - hls(*bg)[1] < 0.5:  # unreadable pair: force extremes
    bg = tuple(x * 0.4 for x in bg) if hls(*bg)[1] > 0.15 else bg
    fg = mix(fg, (255, 255, 255), 0.6)

accent = best(lambda h, l, s: s > 0.3 and 0.3 < l < 0.75, lambda h, l, s: s - abs(l - 0.5))

FAMILIES = {  # ansi slot -> hue center
    1: 0,    # red
    2: 120,  # green
    3: 55,   # yellow
    4: 230,  # blue
    5: 285,  # magenta
    6: 185,  # cyan
}

def family(center):
    lo, hi = (center - 30) % 360, (center + 30) % 360
    pool = [(n, c) for n, c in C
            if (lambda h, l, s: (lo <= h * 360 <= hi if lo < hi else h * 360 >= lo or h * 360 <= hi)
                and s > 0.15 and 0.25 < l < 0.8)(*hls(*c))]
    if pool:
        return max(pool)[1]
    return shift_hue(accent, center)  # hue family absent: rotate the accent

slots = {i: family(FAMILIES[i]) for i in FAMILIES}

def lighten(c):
    h, l, s = hls(*c)
    r, g, b = colorsys.hls_to_rgb(h, l + (1 - l) * 0.25, s * 0.95)
    return (r * 255, g * 255, b * 255)

hexes = {
    "accent": rgb_hex(*accent),
    "cursor": rgb_hex(*accent),
    "foreground": rgb_hex(*fg),
    "background": rgb_hex(*bg),
    "selection_foreground": rgb_hex(*bg),
    "selection_background": rgb_hex(*accent),
    "color0": rgb_hex(*mix(bg, fg, 0.12)),
    "color7": rgb_hex(*mix(fg, bg, 0.15)),
    "color8": rgb_hex(*mix(bg, fg, 0.4)),
    "color15": rgb_hex(*fg),
}
for i, c in slots.items():
    hexes["color%d" % i] = rgb_hex(*c)
    hexes["color%d" % (i + 8)] = rgb_hex(*lighten(c))

print("# extracted from a wallpaper by theme from-image")
for k in ("accent", "cursor", "foreground", "background", "selection_foreground", "selection_background"):
    print('%s = "%s"' % (k, hexes[k]))
print()
for i in range(16):
    print('color%d = "%s"' % (i, hexes["color%d" % i]))
PYEOF
)"
  COLORS_TOML="$(magick "$IMG" -dither None -resize 240x240 -colors 24 -format %c histogram:info:- 2>/dev/null | python3 -c "$PYSCRIPT" "$NAME")" || exit 1

  local DIR="$THEMES_DIR/$NAME" slug
  mkdir -p "$DIR/backgrounds"
  echo "$COLORS_TOML" >"$DIR/colors.toml"
  slug="$(basename "$IMG" | tr '[:upper:]' '[:lower:]' | sed 's/[^a-z0-9.]\+/-/g')"
  cp "$IMG" "$DIR/backgrounds/1-$slug"

  echo "themes/$NAME/colors.toml:"
  echo "$COLORS_TOML"
  if [ -t 1 ]; then
    echo
    local key c
    for key in accent color1 color2 color3 color4 color5 color6; do
      c="$(echo "$COLORS_TOML" | grep -E "^$key = " | cut -d'"' -f2)"
      [ -n "$c" ] && printf '\033[38;2;%sm██\033[0m ' "$(rgb "$c")"
    done
    printf '\n'
  fi
  echo "next: the add-theme skill authors the rest of the pack from colors.toml"
}

# ── Args ────────────────────────────────────────────────────────

[ "${1:-}" = set ] && shift

NAME=""
BG_INDEX=1
case "${1:-}" in
  -h | --help | help) usage; exit 0 ;;
  list | -l | --list)
    if [ -t 1 ]; then
      list_themes | while read -r t; do
        printf '%s\033[1m%s\033[0m \033[2m%s\033[0m\n' "$(swatches "$THEMES_DIR/$t")" "$t" "$(tagline "$THEMES_DIR/$t")"
      done
    else
      list_themes
    fi
    exit 0
    ;;
  current) current_theme; exit 0 ;;
  next) NAME="$(next_theme)" ;;
  from-image) shift; cmd_from_image "$@"; exit $? ;;
  _preview-theme) preview_theme "$2"; exit 0 ;;
  _preview-bg) preview_bg "$2" "$3"; exit 0 ;;
  "") pick_theme ;;
  -*)
    echo "theme: unknown flag '$1'" >&2
    usage >&2
    exit 2
    ;;
  *)
    NAME="$1"
    BG_INDEX="${2:-1}"
    case "$BG_INDEX" in *[!0-9]* | "")
      echo "theme: bg must be a number, got '$BG_INDEX'" >&2
      exit 2
      ;;
    esac
    ;;
esac

THEME_DIR="$THEMES_DIR/$NAME"
if [ ! -d "$THEME_DIR" ]; then
  echo "theme: unknown theme '$NAME'. Available:" >&2
  list_themes >&2
  exit 1
fi

# shellcheck disable=SC1091
source "$THEME_DIR/theme.conf"

if defaults read -g AppleInterfaceStyle >/dev/null 2>&1; then
  MODE=dark
else
  MODE=light
fi

# pick PI_/CLAUDE_ variant, falling back to dark when a theme has no light
pick() {
  local dark_val="$1" light_val="$2"
  if [ "$MODE" = light ] && [ -n "$light_val" ]; then echo "$light_val"; else echo "$dark_val"; fi
}

# ── The switch ──────────────────────────────────────────────────
# everything below reports to stderr; stdout gets the finale only

mkdir -p "$STATE_DIR"
ln -sfn "$THEME_DIR" "$STATE_DIR/current"

# make standalone (non-pack) pi/claude themes available in the live config
# dirs — no-op when those dirs are symlinked into this repo
mkdir -p "$HOME/.claude/themes" "$HOME/.pi/agent/themes"
cp -n "$DOTFILES"/home/.claude/themes/*.json "$HOME/.claude/themes/" 2>/dev/null || true
cp -n "$DOTFILES"/home/.pi/agent/themes/*.json "$HOME/.pi/agent/themes/" 2>/dev/null || true

# packs own their JSONs (pi-dark.json, claude-light.json, ...): install the
# active variant into the live dir under the name theme.conf points at
install_pack_json() { # kind(pi|claude), live dir, theme name
  local f="$THEME_DIR/$1-$MODE.json"
  [ -f "$f" ] || f="$THEME_DIR/$1-dark.json"
  [ ! -f "$f" ] || cp "$f" "$2/$3.json"
  # on machines where ~/.pi / ~/.claude are symlinked into this repo, the
  # install lands in the working tree — keep it out of git status
  local real; real="$(cd "$2" 2>/dev/null && pwd -P)" || return 0
  case "$real" in
    "$DOTFILES"/home/*)
      local rel="${real#$DOTFILES/}/$3.json"
      grep -qxF "$rel" "$DOTFILES/.git/info/exclude" 2>/dev/null || echo "$rel" >>"$DOTFILES/.git/info/exclude"
      ;;
  esac
}

# ghostty: include file + SIGUSR2 live reload
ln -sfn "$THEME_DIR/ghostty.conf" "$HOME/.config/ghostty/theme-current"
pkill -USR2 ghostty 2>/dev/null || true

# wezterm: real-file copy bumps mtime; wezterm.lua watches + merges it
if [ -f "$THEME_DIR/wezterm.lua" ] && [ -d "$HOME/.config/wezterm" ]; then
  cp "$THEME_DIR/wezterm.lua" "$HOME/.config/wezterm/theme-current.lua"
fi

# btop: install the theme + point btop.conf at it (applies on next launch).
# a running btop rewrites btop.conf from memory on exit and would clobber this.
if [ -f "$THEME_DIR/btop.theme" ] && [ -f "$HOME/.config/btop/btop.conf" ]; then
  mkdir -p "$HOME/.config/btop/themes"
  cp "$THEME_DIR/btop.theme" "$HOME/.config/btop/themes/$NAME.theme"
  sed -i '' "s|^color_theme = .*|color_theme = \"$HOME/.config/btop/themes/$NAME.theme\"|" "$HOME/.config/btop/btop.conf"
  pgrep -x btop >/dev/null 2>&1 && echo "theme: btop is running — quit and reopen it, it re-reads the theme at launch" >&2
fi

# nvim: always reload aether — we no longer use per-theme named colorschemes.
find "${TMPDIR:-/tmp}" -maxdepth 4 -type s -name 'nvim.*.0' 2>/dev/null | while read -r sock; do
  nvim --server "$sock" --remote-expr "execute('lua if _G.apply_named_theme then _G.apply_named_theme() end')" 2>/dev/null || true
done

# tmux
tmux has-session 2>/dev/null && tmux source-file "$HOME/.config/tmux/tmux.conf" || true

# sketchybar
pgrep -x sketchybar >/dev/null 2>&1 && sketchybar --reload || true

# borders (runs as a brew service on this machine)
brew services restart borders >/dev/null 2>&1 || true

# wallpaper: Nth image in backgrounds/ (default first), every screen.
# macOS applies wallpaper async — expect a few seconds of lag.
BGS=()
while IFS= read -r b; do BGS+=("$b"); done < <(ls "$THEME_DIR"/backgrounds/* 2>/dev/null)
if [ "${#BGS[@]}" -gt 0 ] && [ "$BG_INDEX" -gt "${#BGS[@]}" ]; then
  echo "theme: $NAME has ${#BGS[@]} wallpaper(s), no number $BG_INDEX" >&2
  exit 2
fi
WALL="${BGS[$((BG_INDEX - 1))]:-}"
if [ -n "$WALL" ]; then
  # path stays an ARGUMENT, never spliced into script text
  if ! osascript - "$WALL" >/dev/null 2>&1 <<'APPLESCRIPT'; then
on run argv
  tell application "System Events" to tell every desktop to set picture to (item 1 of argv)
end run
APPLESCRIPT
    echo "theme: wallpaper failed (Automation permission for System Events?)" >&2
  else
    echo "wallpaper: $(basename "$WALL") (applies in a few seconds)" >&2
  fi
fi

# pi + claude: point settings.json at the theme (next launch)
set_json_theme() { # file, value
  local file="$1" value="$2" tmp
  [ -f "$file" ] || return 0
  tmp="$(mktemp)"
  jq --arg t "$value" '.theme = $t' "$file" >"$tmp" && mv "$tmp" "$file"
}
PI_THEME="$(pick "${PI_DARK:-}" "${PI_LIGHT:-}")"
CLAUDE_THEME="$(pick "${CLAUDE_DARK:-}" "${CLAUDE_LIGHT:-}")"
[ -n "$PI_THEME" ] && install_pack_json pi "$HOME/.pi/agent/themes" "$PI_THEME"
[ -n "$CLAUDE_THEME" ] && install_pack_json claude "$HOME/.claude/themes" "$CLAUDE_THEME"
[ -n "$PI_THEME" ] && for f in "$HOME/.pi/agent/settings.json" "$DOTFILES/home/.pi/agent/settings.json"; do set_json_theme "$f" "$PI_THEME"; done
[ -n "$CLAUDE_THEME" ] && for f in "$HOME/.claude/settings.json" "$DOTFILES/home/.claude/settings.json"; do set_json_theme "$f" "custom:$CLAUDE_THEME"; done

# starship: rebuild the palettes section from every pack's starship.palette
# (deleted packs drop out), then point at the active one. Re-read every
# prompt, so no reload needed.
if [ -f "$THEME_DIR/starship.palette" ]; then
  stripped="$(mktemp)"; blocks="$(mktemp)"
  awk '/^\[palettes\./{skip=1; next} /^\[/{skip=0} !skip' "$DOTFILES/config/starship.toml" >"$stripped"
  for p in "$THEMES_DIR"/*/starship.palette; do
    [ -f "$p" ] || continue
    printf '\n[palettes.%s]\n' "$(basename "$(dirname "$p")")" >>"$blocks"
    cat "$p" >>"$blocks"
  done
  sed -i '' -e "/^palette = /r $blocks" "$stripped"
  sed -i '' "s/^palette = \".*\"/palette = \"$NAME\"/" "$stripped"
  cmp -s "$stripped" "$DOTFILES/config/starship.toml" || mv "$stripped" "$DOTFILES/config/starship.toml"
  rm -f "$stripped" "$blocks"
else
  echo "theme: no starship.palette in $NAME — prompt colors stale" >&2
fi

# slack: no API for this — put the sidebar theme string on the clipboard
if [ -f "$THEME_DIR/slack.txt" ]; then
  pbcopy <"$THEME_DIR/slack.txt"
  echo "slack theme on clipboard — Slack > Settings > Appearance > Custom theme > Import, then paste" >&2
fi

# ── Finale ──────────────────────────────────────────────────────

if [ -t 1 ] && [ -f "$THEME_DIR/colors.toml" ]; then
  swatches "$THEME_DIR"
  printf '\n'
  name_painted "$THEME_DIR" "$NAME"
  [ -n "${TAGLINE:-}" ] && printf '  \033[2m%s\033[0m' "$TAGLINE"
  printf '  \033[2m(%s)\033[0m\n' "$MODE"
else
  echo "theme: $NAME ($MODE)"
fi
