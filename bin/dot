#!/usr/bin/env bash

set -Eeuo pipefail
trap cleanup SIGINT SIGTERM ERR EXIT

cleanup() {
  trap - SIGINT SIGTERM ERR EXIT
}

command_name=$(basename "${BASH_SOURCE[0]}")
script_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" &>/dev/null && pwd -P)
CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"

if [[ -f "$DOTFILES/bin/lib/common.sh" ]]; then
  source "$DOTFILES/bin/lib/common.sh"
else
  echo "Error: Unable to source common.sh"
  exit 1
fi

find_commands() {
  IFS=: read -ra path_dirs <<<"$PATH"
  for dir in "${path_dirs[@]}"; do
    # skip if the directory doesn't exist or isn't readable
    [[ ! -d "$dir" ]] && continue
    for cmd in "$dir"/dot-*; do
      [[ -f "$cmd" && -x "$cmd" ]] || continue
      basename "$cmd" | sed 's/^dot-//'
    done
  done | sort -u
}

usage() {
  cat <<EOF
  $(fmt_key "Usage:") $(fmt_cmd "$command_name") $(fmt_value "<command> [subcommand] [options]")

Dotfiles management script.

$(fmt_key "Available Commands:")
    help                          Show this help message
    link [pkg]                    Link packages (default: all)
        clean                     Remove broken symlinks
            -n, --dry-run         Preview without removing
    unlink [pkg]                  Unlink packages (default: all)
    filters                       Register git clean filters (run after clone)
EOF

  echo -e "\nExternal commands:"

  find_commands | while read -r cmd; do
    # Get the description from the script if available
    description=$(grep "^# Description:" "$(which "dot-$cmd")" 2>/dev/null | cut -d: -f2- | sed 's/^[[:space:]]*//' || echo "No description available")
    printf "    $(fmt_cmd "%-12s") %s\n" "$cmd" "$description"
  done
}

# Git clean filters for config files that apps pollute with their own state.
# .gitattributes maps a path to a filter name; the definition has to live in
# .git/config, which isn't tracked — hence this command.
#
# Each entry is "<filter name>:<jq program>". The program runs on the working
# tree copy before git compares or stages it, so stripped keys never reach a
# commit while staying put on disk.
cmd_filters() {
  local filters=(
    "pi-settings:del(.lastChangelogVersion)"
  )

  if ! command -v jq >/dev/null 2>&1; then
    log_error "jq not found — install it before registering git filters"
    return 1
  fi

  for entry in "${filters[@]}"; do
    local name="${entry%%:*}"
    local program="${entry#*:}"
    git -C "$DOTFILES" config "filter.$name.clean" "jq '$program'"
    # required=false: if jq ever fails, git stages the file unfiltered rather
    # than aborting. Noisy diff beats a broken commit.
    git -C "$DOTFILES" config "filter.$name.required" false
    log_success "Registered clean filter: $name"
  done
}

# ── Link / Unlink ───────────────────────────────────────────────
#
# The symlink layout lives in [dotfiles] in config/mise/config.toml. These stay
# as wrappers so `dot link nvim` keeps working, but mise does the linking and
# owns the state — there is one description of the layout, not two.

# Target path that a package's [dotfiles] entry writes to.
pkg_target() {
  local pkg="$1"
  if [ -e "$DOTFILES/config/$pkg" ]; then
    echo "$CONFIG_HOME/$pkg"
  elif [ -e "$DOTFILES/home/.$pkg" ]; then
    echo "$HOME/.$pkg"
  else
    return 1
  fi
}

cmd_link() {
  local operation="$1"
  shift

  # Handle 'dot link clean' — pass remaining args through
  if [ "$operation" = "link" ] && [[ "${1:-}" == "clean" ]]; then
    shift
    cmd_link_clean "$@"
    return
  fi

  if ! command -v mise &>/dev/null; then
    log_error "mise not found — install it first: curl https://mise.run | sh"
    return 1
  fi

  local pkg="all"
  while [[ $# -gt 0 ]]; do
    case "$1" in
    -*) log_error "Unknown option: $1"; exit 1 ;;
    *) pkg="$1"; shift ;;
    esac
  done

  local subcommand="apply"
  [ "$operation" = "unlink" ] && subcommand="unapply"

  if [ "$pkg" = "all" ]; then
    mise bootstrap dotfiles "$subcommand" --yes
  else
    local target
    if ! target="$(pkg_target "$pkg")"; then
      log_error "Package \"$pkg\" not found in config/ or home/"
      return 1
    fi
    mise bootstrap dotfiles "$subcommand" --yes "$target"
  fi

  # A full link is the closest thing to a bootstrap, so register the git
  # clean filters here too — they're per-clone and easy to forget otherwise.
  [ "$operation" = "link" ] && cmd_filters

  return 0
}

# ── Clean broken symlinks ───────────────────────────────────────

cmd_link_clean() {
  local dry_run=false

  while [[ $# -gt 0 ]]; do
    case "$1" in
    -n | --dry-run) dry_run=true; shift ;;
    *) log_error "Unknown argument: $1"; exit 1 ;;
    esac
  done

  printf "\n  ${BOLD}dot link clean${RESET}"
  [ "$dry_run" = true ] && printf " ${DIM}(dry run)${RESET}"
  printf "\n\n"

  local broken_count=0

  # Check config directory symlinks
  if [ -d "$CONFIG_HOME" ]; then
    while IFS= read -r -d '' link; do
      if [ -L "$link" ] && [ ! -e "$link" ]; then
        broken_count=$((broken_count + 1))
        local display="~${link#"$HOME"}"
        if [ "$dry_run" = true ]; then
          printf "  ${YELLOW}⚠ %s${RESET}\n" "$display"
        else
          printf "  ${RED}- %s${RESET}\n" "$display"
          rm "$link"
        fi
      fi
    done < <(find "$CONFIG_HOME" -type l -print0 2>/dev/null || true)
  fi

  # Check home directory symlinks
  if [ -d "$DOTFILES/home" ]; then
    shopt -s dotglob
    for entry in "$DOTFILES/home"/*; do
      [ -e "$entry" ] || continue
      local name="$(basename "$entry")"
      [[ "$name" == ".DS_Store" ]] && continue
      local target_path="$HOME/$name"
      if [ -L "$target_path" ] && [ ! -e "$target_path" ]; then
        local link_target
        link_target=$(readlink "$target_path")
        if [[ "$link_target" == "$DOTFILES"* ]]; then
          broken_count=$((broken_count + 1))
          if [ "$dry_run" = true ]; then
            printf "  ${YELLOW}⚠ ~/%s${RESET}\n" "$name"
          else
            printf "  ${RED}- ~/%s${RESET}\n" "$name"
            rm "$target_path"
          fi
        fi
      fi
    done
    shopt -u dotglob
  fi

  echo
  if [ "$broken_count" -eq 0 ]; then
    printf "  ${BOLD}${SUCCESS_ICON}${RESET} ${DIM}no broken symlinks${RESET}\n"
  elif [ "$dry_run" = true ]; then
    printf "  ${BOLD}${WARNING_ICON}${RESET} ${YELLOW}%d broken symlink(s)${RESET} ${DIM}— run without --dry-run to remove${RESET}\n" "$broken_count"
  else
    printf "  ${BOLD}${SUCCESS_ICON}${RESET} ${GREEN}removed %d broken symlink(s)${RESET}\n" "$broken_count"
  fi
  echo
}

main() {
  if [ $# -lt 1 ]; then
    usage
    exit 0
  fi

  cmd="$1"
  shift || true
  subcmd="${1:-all}"

  case "$cmd" in
  help)
    usage
    ;;
  link)
    cmd_link "link" "$@"
    ;;
  filters)
    cmd_filters
    ;;
  unlink)
    cmd_link "unlink" "$@"
    ;;
  *)
    if command -v "dot-$cmd" >/dev/null 2>&1; then
      "dot-$cmd" "$@"
    else
      log_error "Unknown command: $cmd"
      usage
      exit 1
    fi
    ;;
  esac
}

main "$@"
