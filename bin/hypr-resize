#!/usr/bin/env bash
# hypr-resize <pixels> -- grow (positive) or shrink (negative) the FOCUSED window.
#
# Hyprland's resize dispatcher is border-relative, not focus-relative: a positive
# x always pushes the shared border rightward, so on a right-hand window "+"
# makes it smaller. splitratio has the same problem in the same direction. This
# picks the sign from where the window sits, so "+" always means bigger.
#
# The side test compares the window's centre against the monitor's centre.
# Monitor width is in physical pixels and window geometry is logical, so the
# monitor is divided by its scale before comparing.
set -euo pipefail

delta=${1:?usage: hypr-resize <pixels>}

read -r wx wy ww wh < <(hyprctl activewindow -j |
  jq -r '"\(.at[0]) \(.at[1]) \(.size[0]) \(.size[1])"')

read -r mx my mw mh < <(hyprctl monitors -j |
  jq -r '.[] | select(.focused) | "\(.x) \(.y) \(.width / .scale | floor) \(.height / .scale | floor)"')

# Centre of the window vs centre of the monitor, per axis.
(( wcx = wx + ww / 2, wcy = wy + wh / 2 ))
(( mcx = mx + mw / 2, mcy = my + mh / 2 ))

(( dx = wcx < mcx ? delta : -delta ))
(( dy = wcy < mcy ? delta : -delta ))

hyprctl dispatch "hl.dsp.window.resize({ x = $dx, y = $dy, relative = true })" >/dev/null
