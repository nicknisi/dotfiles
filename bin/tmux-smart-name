#!/bin/bash
# Name windows after their highest-ranked pane: agent > editor > TUI > shell.
# Standalone: tmux-smart-name CMD PATH TTY [WINDOW_ID]
# Status helper: source this file and call smart_name_refresh. One batch handles
# all windows, at most once every five seconds, without a per-window shell job.

# Open the sibling directly so symlink/../ paths retain filesystem semantics.
source "${BASH_SOURCE[0]%/*}/nerdwin"
SMART_NAME_FORMAT=$'#{window_id}\037#{pane_active}\037#{pane_current_command}\037#{pane_current_path}\037#{pane_tty}\037#{automatic-rename}\037#{window_name}'

smart_name() {
  local path=$1 root dir_name parent_dir parent_name grandparent_dir branch project
  [[ -n $path ]] || return 0
  [[ $path == "$HOME" ]] && { printf '~'; return; }
  root=$(GIT_OPTIONAL_LOCKS=0 git -C "$path" rev-parse --show-toplevel 2>/dev/null)
  [[ -n $root ]] && path=$root
  path=${path%/}
  path=${path:-/}
  dir_name=${path##*/}
  dir_name=${dir_name:-/}

  if [[ -f "$path/.git" ]]; then
    parent_dir=${path%/*}
    parent_dir=${parent_dir:-/}
    parent_name=${parent_dir##*/}
    branch=$(GIT_OPTIONAL_LOCKS=0 git -C "$path" rev-parse --abbrev-ref HEAD 2>/dev/null)
    grandparent_dir=${parent_dir%/*}
    if [[ $parent_name == worktrees && ${grandparent_dir##*/} == .claude ]]; then
      project=${grandparent_dir%/*}
      project=${project##*/}
      [[ -n $branch && $branch != HEAD ]] || branch=$dir_name
      printf '%s (%s)' "$project" "$branch"
      return
    fi
    if [[ -d "$parent_dir/.bare" && -n $branch ]]; then
      printf '%s (%s)' "$parent_name" "$branch"
      return
    fi
  fi
  printf '%s' "$dir_name"
}

# One process snapshot for only the node panes' terminals. The caller owns
# pi_ttys so pane selection below needs no ps/grep subprocesses of its own.
smart_name_pi_ttys() {
  local window active cmd path tty auto name ttys="" comm
  pi_ttys=" "
  while IFS=$'\037' read -r window active cmd path tty auto name; do
    [[ $auto == 1 && $cmd == node && -n $tty ]] || continue
    ttys+="${ttys:+,}${tty#/dev/}"
  done <<<"$1"
  [[ -n $ttys ]] || return 0
  while read -r tty comm; do
    [[ $comm == pi ]] && pi_ttys+="$tty "
  done < <(ps -t "$ttys" -o tty=,comm= 2>/dev/null)
}

smart_name_consider() {
  local cmd=$1 tty=${3#/dev/} active=$4 rank
  if [[ $cmd =~ ^[0-9]+[._][0-9]+[._][0-9]+$ ]]; then
    cmd=claude
  elif [[ $cmd == node && -n $tty && $pi_ttys == *" $tty "* ]]; then
    cmd=pi
  fi
  case $cmd in
    claude | pi | codex | opencode | aider | gemini | amp | goose) rank=90 ;;
    nvim | vim | vi | lvim | hx | helix | emacs | nano) rank=70 ;;
    lazygit | tig | htop | btop | top | yazi | lf | lfcd | ranger | k9s | lazydocker) rank=50 ;;
    zsh | bash | fish | sh | tcsh | nu) rank=10 ;;
    fleet) rank=5 ;;
    *) rank=40 ;;
  esac
  if ((rank > best_rank || (rank == best_rank && active == 1 && best_active != 1))); then
    best_rank=$rank best_cmd=$cmd best_path=$2 best_active=$active
  fi
}

smart_name_label() {
  printf '%s %s' "$(nerdwin "$best_cmd")" "$(smart_name "$best_path")"
}

smart_name_queue() {
  ((best_rank >= 0)) || return 0
  local name
  name=$(smart_name_label)
  [[ $name != "$old_name" ]] || return 0
  # rename-window opts out of automatic naming; restore it only for windows
  # which already opted in. An explicit user rename stays opted out.
  changes+=(rename-window -t "$window" "$name" \;
    set-window-option -t "$window" automatic-rename on \;)
}

smart_name_refresh() {
  local now next panes id active cmd path tty auto name window="" old_name=""
  local best_rank=-1 best_active=0 best_cmd="" best_path="" pi_ttys seen=" " skip=0
  local changes=()
  IFS='|' read -r now next <<<"$(tmux display-message -p '%s|#{@smart_name_next}' 2>/dev/null)"
  [[ $now =~ ^[0-9]+$ ]] || return 0
  [[ $next =~ ^[0-9]+$ ]] || next=0
  # Ignore an old deadline after a wall-clock jump backwards.
  ((next > now && next <= now + 5)) && return 0
  panes=$(tmux set-option -gq @smart_name_next "$((now + 5))" \; \
    list-panes -a -F "$SMART_NAME_FORMAT" 2>/dev/null) || return 0
  smart_name_pi_ttys "$panes"
  while IFS=$'\037' read -r id active cmd path tty auto name; do
    [[ -n $id ]] || continue
    if [[ $id != "$window" ]]; then
      smart_name_queue
      window=$id old_name=$name best_rank=-1 best_active=0 skip=0
      # Linked windows appear once per session in list-panes -a.
      [[ $seen == *" $id "* ]] && skip=1
      seen+="$id "
    fi
    [[ $auto == 1 && $skip == 0 ]] && smart_name_consider "$cmd" "$path" "$tty" "$active"
  done <<<"$panes"
  smart_name_queue
  ((${#changes[@]})) && tmux "${changes[@]:0:${#changes[@]}-1}" 2>/dev/null
  return 0
}

smart_name_main() {
  [[ ${1:-} == --refresh ]] && { smart_name_refresh; return; }
  local panes="" window active cmd path tty auto name pi_ttys
  local best_rank=-1 best_active=0 best_cmd="" best_path=""
  [[ -n ${4:-} ]] && panes=$(tmux list-panes -t "$4" -F "$SMART_NAME_FORMAT" 2>/dev/null)
  if [[ -z $panes ]]; then
    printf -v panes '@0\0371\037%s\037%s\037%s\0371\037' "${1:-}" "${2:-}" "${3:-}"
  fi
  smart_name_pi_ttys "$panes"
  while IFS=$'\037' read -r window active cmd path tty auto name; do
    smart_name_consider "$cmd" "$path" "$tty" "$active"
  done <<<"$panes"
  smart_name_label
  printf '\n'
}

if [[ ${BASH_SOURCE[0]} == "$0" ]]; then
  smart_name_main "$@"
fi
