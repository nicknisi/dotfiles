#!/usr/bin/env bash
# Based on https://github.com/joshmedeski/tmux-nerd-font-window-name

NAME=$1
SHOW_NAME="$(tmux show -gqv '@tmux-nerd-font-window-name-show-name')"

function get_shell_icon() {
  local default_shell_icon=""
  local shell_icon
  shell_icon="$(tmux show -gqv '@tmux-nerd-font-window-name-shell-icon')"
  if [ "$shell_icon" != "" ]; then
    echo "$shell_icon"
  else
    echo "$default_shell_icon"
  fi
}

SHELL_ICON=$(get_shell_icon)

get_icon() {
  case $NAME in
  tmux)
    echo ""
    ;;
  htop | top)
    echo ""
    ;;
  fish | zsh | bash | tcsh)
    echo "$SHELL_ICON"
    ;;
  vi | vim | nvim | lvim)
    echo ""
    ;;
  lazygit | git | tig)
    echo ""
    ;;
  claude)
    echo "󱙺"
    ;;
  pi)
    echo "π"
    ;;
  fleet)
    echo "☰"
    ;;
  node)
    echo "󰎙"
    ;;
  ruby)
    echo ""
    ;;
  go)
    echo ""
    ;;
  lf | lfcd)
    echo ""
    ;;
  beam | beam.smp) # Erlang runtime
    echo ""
    ;;
  rustc | rustup)
    echo ""
    ;;
  codex | aider | gemini | amp | goose)
    echo $'\xf3\xb0\x9a\xa9' # U+F06A9 nf-md-robot
    ;;
  opencode)
    echo $'\xf3\xb1\x9c\x99' # U+F1719 nf-md-robot_happy
    ;;
  bun | deno)
    echo $'\xf3\xb0\x8e\x99' # U+F0399 nf-md-nodejs (same family as node)
    ;;
  docker | docker-compose | lazydocker)
    echo $'\xf3\xb0\xa1\xa8' # U+F0868 nf-md-docker
    ;;
  Python | python | python3)
    echo ""
    ;;
  *)
    if [ "$SHOW_NAME" = true ]; then
      echo ""
    else
      echo "$NAME"
    fi
    ;;
  esac
}

ICON=$(get_icon)

# if [ "$SHOW_NAME" = true ]; then
#   echo "$ICON" "$NAME"
# else
echo "$ICON"
# fi
