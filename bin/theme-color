#!/usr/bin/env python3
"""theme-color — resolve a pack's colors.toml into the full palette; render templates.

  theme-color [-f colors.toml] [--name N] [--mode dark|light] KEY [FALLBACK]
  theme-color [...] --all                     every resolved key<TAB>value
  theme-color [...] --json                    the resolved palette as JSON
  theme-color [...] --render OUTDIR TPL...    OUTDIR/<tpl minus .tpl>; existing outputs are left alone
  theme-color [...] --stdout TPL              one template to stdout

colors.toml is flat `key = "#rrggbb"` lines. A pack may be ANSI-style (accent,
foreground, background, color0-15, which is what this repo's packs carry) or
semantic (red, muted, dark_background, ...). Either resolves to the full key
set the templates use; anything a pack does not name is aliased from the other
style or mixed from what it has.

Template tokens:
  {{ key }}            #rrggbb
  {{ key_strip }}      rrggbb        hypr rgba(..ff), Qt #aarrggbb, sketchybar 0xaa..
  {{ key_rgb }}        r,g,b         css rgb(), claude themes
  {{ key_float }}      r, g, b       0..1 floats: plymouth's script module
  {{ key_str }}        the value escaped for a "double-quoted" literal (\\ and \")
  {{ mix a b 30% }}    a moved 30% toward b; mix_strip / mix_rgb / mix_float likewise
  {{ name }} {{ mode }}
  {{ tagline }}        TAGLINE from the theme.conf beside colors.toml ("" without one)
  {{ hostname }}       this machine's short hostname (templates only, not in --json)
  {{ hyprland_active_border_lua }}    the pack's hyprland_active_border, or its accent,
                                      as the Lua literal hl.config takes; _inactive_ likewise
Shell tokens (surface, raised, overlay, hairline, fill_low, fill_high, ink_dim,
ink_mid, faint, accent_tint, on_accent, bad, darker, shadow_alpha) follow the
island shell's token rules; see shell_tokens(). They are in --json too, so
Quickshell reads the same values Plymouth is rendered with.
An unknown token is left in place and reported on stderr, so a typo in a
template is visible in the rendered file rather than silently blank.
"""

import argparse
import json
import math
import os
import re
import socket
import sys

HEX = re.compile(r"^#?([0-9a-fA-F]{6})([0-9a-fA-F]{2})?$")
TOKEN = re.compile(r"\{\{\s*([^{}]+?)\s*\}\}")
DEFAULT_FILE = os.path.expanduser("~/.local/state/theme/current/theme/colors.toml")

# semantic name -> the ANSI slot that holds it (and back)
ANSI = {
    "red": "color1", "green": "color2", "yellow": "color3", "blue": "color4",
    "magenta": "color5", "cyan": "color6", "muted": "color8",
    "bright_red": "color9", "bright_green": "color10", "bright_yellow": "color11",
    "bright_blue": "color12", "bright_magenta": "color13", "bright_cyan": "color14",
    "bright_foreground": "color15",
}
# Short spellings
SHORT = {
    "background": "bg", "foreground": "fg", "dark_background": "dark_bg",
    "darker_background": "darker_bg", "lighter_background": "lighter_bg",
    "dark_foreground": "dark_fg", "light_foreground": "light_fg",
    "bright_foreground": "bright_fg",
}


def norm(v):
    m = HEX.match(v.strip())
    return "#" + m.group(1).lower() if m else v.strip()


def is_hex(v):
    return bool(HEX.match(v))


def rgb(v):
    h = v.lstrip("#")
    return int(h[0:2], 16), int(h[2:4], 16), int(h[4:6], 16)


def hexs(r, g, b):
    return "#%02x%02x%02x" % tuple(max(0, min(255, round(x))) for x in (r, g, b))


def mix(a, b, amount):
    """a moved `amount` of the way toward b. amount: 0.3, 30, or '30%'."""
    if isinstance(amount, str):
        amount = float(amount[:-1]) / 100 if amount.endswith("%") else float(amount)
    if amount > 1:
        amount /= 100
    amount = max(0.0, min(1.0, amount))
    ra, ga, ba = rgb(a)
    rb, gb, bb = rgb(b)
    return hexs(ra + (rb - ra) * amount, ga + (gb - ga) * amount, ba + (bb - ba) * amount)


def luminance(v):
    r, g, b = rgb(v)
    return 0.2126 * r + 0.7152 * g + 0.0722 * b


def hypr_lua(spec):
    """A Hyprland colour spec in conf syntax -> the Lua literal hl.config takes.

    One colour stays a string. "rgba(a) rgba(b) 45deg" is a gradient, and the
    Lua API wants that as { colors = { ... }, angle = 45 } rather than the
    space-separated string, which it rejects as an invalid colour. A bare hex
    (what norm() leaves a "#rrggbb" as) becomes rgb(rrggbb), since Hyprland
    does not read the # form.
    """
    colors, angle = [], None
    for tok in spec.split():
        if tok.endswith("deg"):
            angle = int(round(float(tok[:-3])))
        elif is_hex(tok):
            colors.append("rgb(%s)" % tok.lstrip("#"))
        else:
            colors.append(tok)
    if len(colors) == 1 and angle is None:
        return '"%s"' % colors[0]
    lua = "{ colors = { %s }" % ", ".join('"%s"' % c for c in colors)
    if angle is not None:
        lua += ", angle = %d" % angle
    return lua + " }"


# ── Shell tokens ────────────────────────────────────────────────
# The island shell's surfaces, inks and states, derived from the palette by the
# same rules as the design mocks' themeVals(), so Plymouth, Quickshell and the
# mocks agree to the channel. Mirrored exactly, rounding included: these helpers
# round like JS Math.round and never clamp the mix amount (mix() above does
# both differently, and the ink_dim search can step k a hair past 1).

def _js_round(x):
    return int(math.floor(x + 0.5))


def _hex_js(chans):
    return "#" + "".join("%02x" % _js_round(max(0, min(255, v))) for v in chans)


def _mix_js(a, b, t):
    x, y = rgb(a), rgb(b)
    return _hex_js([x[i] + (y[i] - x[i]) * t for i in range(3)])


def _lum(v):
    def lin(c):
        c /= 255
        return c / 12.92 if c <= 0.03928 else ((c + 0.055) / 1.055) ** 2.4
    r, g, b = (lin(c) for c in rgb(v))
    return 0.2126 * r + 0.7152 * g + 0.0722 * b


def contrast(a, b):
    x, y = _lum(a), _lum(b)
    return (max(x, y) + 0.05) / (min(x, y) + 0.05)


def _hue(v):
    r, g, b = (c / 255 for c in rgb(v))
    mx, mn = max(r, g, b), min(r, g, b)
    d = mx - mn
    if not d:
        return 0.0
    if mx == r:
        h = math.fmod((g - b) / d, 6)
    elif mx == g:
        h = (b - r) / d + 2
    else:
        h = (r - g) / d + 4
    return math.fmod(h * 60 + 360, 360)


def shell_tokens(p, raw):
    """Fill the shell tokens into p (a pack may set any of them itself)."""
    bg, fg, accent = p["background"], p["foreground"], p["accent"]
    dark = p["mode"] != "light"
    t = {}
    t["surface"] = p.get("surface") or _mix_js(bg, fg, 0.04)
    surface = t["surface"]
    k = 0.62
    ink = _mix_js(bg, fg, k)
    while contrast(ink, surface) < 4.5 and k < 1:  # first step that reads at 4.5:1
        k += 0.02
        ink = _mix_js(bg, fg, k)
    t["ink_dim"] = ink
    t["ink_mid"] = _mix_js(bg, fg, max(0.5, k - 0.1))
    t["raised"] = _mix_js(bg, fg, 0.08)
    t["overlay"] = _mix_js(bg, fg, 0.12)
    t["hairline"] = _mix_js(surface, fg, 0.14)
    t["fill_low"] = _mix_js(surface, fg, 0.06)
    t["fill_high"] = _mix_js(surface, fg, 0.13)
    t["faint"] = _mix_js(bg, fg, 0.375)
    t["accent_tint"] = _mix_js(surface, accent, 0.16 if dark else 0.14)
    on = bg if contrast(bg, accent) >= contrast(fg, accent) else fg
    if contrast(on, accent) < 4.5:
        on = "#ffffff" if contrast("#ffffff", accent) >= contrast("#000000", accent) else "#000000"
    t["on_accent"] = on
    # errors in a red that reads as red: hackerman's "red" is a green, like its accent
    hd = abs(_hue(p["red"]) - _hue(accent))
    near = min(hd, 360 - hd) < 40
    t["bad"] = ("#ff6b6b" if dark else "#d20f39") if near else p["red"]
    # the pack's own darker_background, else a shallower step than the resolver's 50%
    own = raw.get("darker_background") or raw.get("darker_bg")
    t["darker"] = own if own and is_hex(own) else _mix_js(bg, "#000000", 0.3 if dark else 0.06)
    t["shadow_alpha"] = "0.45" if dark else "0.14"
    for key, value in t.items():
        p.setdefault(key, value)


def tagline(colors_path):
    """TAGLINE="..." from the theme.conf beside colors.toml, as bin/theme sources it."""
    try:
        with open(os.path.join(os.path.dirname(os.path.abspath(colors_path)), "theme.conf"), encoding="utf-8") as fh:
            conf = fh.read()
    except OSError:
        return ""
    m = re.search(r"""^\s*TAGLINE=(?:"([^"]*)"|'([^']*)'|(\S*))""", conf, re.M)
    return next((g for g in m.groups() if g is not None), "") if m else ""


def parse(path):
    raw = {}
    with open(path, encoding="utf-8") as fh:
        for line in fh:
            line = line.strip()
            if not line or line.startswith("#") or "=" not in line:
                continue
            key, val = line.split("=", 1)
            key = key.strip().strip("\"'")
            val = val.strip()
            if val[:1] in ("\"", "'"):
                val = val[1:].split(val[0], 1)[0]
            else:
                val = val.split("#", 1)[0].strip()
            if re.match(r"^[A-Za-z0-9_-]+$", key) and val:
                raw[key] = norm(val)
    return raw


def resolve(raw, name=None, mode=None):
    p = dict(raw)

    def need(key, *candidates):
        """Set p[key] from the first candidate that yields: a key already in p, or a callable."""
        if key in p:
            return
        for c in candidates:
            if callable(c):
                v = c()
                if v:
                    p[key] = v
                    return
            elif c in p:
                p[key] = p[c]
                return

    for long, short in SHORT.items():
        need(long, short)
    need("magenta", "purple")
    need("bright_magenta", "bright_purple")
    need("background", "color0")
    need("foreground", "color15", "color7")
    if "background" not in p or "foreground" not in p:
        sys.exit("theme-color: colors.toml needs at least background and foreground")
    bg, fg = p["background"], p["foreground"]

    for sem, slot in ANSI.items():
        need(sem, slot)
    for hue in ("red", "green", "yellow", "blue", "magenta", "cyan"):
        need(hue, "foreground")
        need("bright_" + hue, lambda h=hue: mix(p[h], "#ffffff", 0.2))
    # color7 is "normal white": the dimmer text tone when the pack keeps it distinct from fg
    need("dark_foreground", lambda: p.get("color7") if p.get("color7") != fg else None,
         lambda: mix(fg, bg, 0.3))
    need("bright_foreground", "foreground")
    need("light_foreground", lambda: mix(fg, "#ffffff", 0.2))
    need("muted", lambda: mix(bg, fg, 0.35))
    need("accent", "blue")
    need("cursor", "bright_foreground")
    need("selection_background", "selection", lambda: mix(bg, fg, 0.2))
    need("selection", "selection_background")
    need("selection_foreground", "foreground")
    need("orange", "yellow")
    need("brown", lambda: mix(p["orange"], "#000000", 0.5))
    need("dark_background", lambda: mix(bg, "#000000", 0.25))
    need("darker_background", lambda: mix(bg, "#000000", 0.5))
    need("lighter_background", lambda: mix(bg, fg, 0.08))
    need("purple", "magenta")
    need("bright_purple", "bright_magenta")

    # Window borders. A pack may set these in Hyprland's own syntax, gradients
    # included; the rest get the accent at full alpha and muted at 0xaa, which
    # is what the capsule's Theme.qml mirrors for its own borders.
    need("hyprland_active_border", lambda: "rgba(%sff)" % p["accent"].lstrip("#"))
    need("hyprland_inactive_border", lambda: "rgba(%saa)" % p["muted"].lstrip("#"))
    p["hyprland_active_border_lua"] = hypr_lua(p["hyprland_active_border"])
    p["hyprland_inactive_border_lua"] = hypr_lua(p["hyprland_inactive_border"])

    for sem, slot in ANSI.items():
        need(slot, sem)
    need("color0", "background")
    need("color7", "dark_foreground")
    for long, short in SHORT.items():
        need(short, long)

    p["mode"] = mode or p.get("mode") or p.get("theme_type") or ("light" if luminance(bg) > 128 else "dark")
    p["theme_type"] = p["mode"]
    if name:
        p["name"] = name
    shell_tokens(p, raw)
    return p


def render(text, p, warn):
    def sub(m):
        token = m.group(0)
        parts = m.group(1).split()
        if len(parts) == 1:
            key = parts[0]
            if key.endswith("_str") and key[:-4] in p:
                return p[key[:-4]].replace("\\", "\\\\").replace('"', '\\"')
            for suffix, fn in (("_strip", lambda v: v.lstrip("#")),
                               ("_rgb", lambda v: "%d,%d,%d" % rgb(v)),
                               ("_float", lambda v: "%.3f, %.3f, %.3f" % tuple(c / 255 for c in rgb(v)))):
                base = key[: -len(suffix)]
                if key.endswith(suffix) and base in p:
                    v = p[base]
                    return fn(v) if is_hex(v) else v
            if key in p:
                return p[key]
        elif len(parts) == 4 and parts[0] in ("mix", "mix_strip", "mix_rgb", "mix_float"):
            fn, a, b, amount = parts
            va, vb = p.get(a, a), p.get(b, b)
            if is_hex(va) and is_hex(vb):
                v = mix(va, vb, amount)
                if fn == "mix_strip":
                    return v.lstrip("#")
                if fn == "mix_rgb":
                    return "%d,%d,%d" % rgb(v)
                if fn == "mix_float":
                    return "%.3f, %.3f, %.3f" % tuple(c / 255 for c in rgb(v))
                return v
        warn(token)
        return token

    return TOKEN.sub(sub, text)


def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("-f", "--file", default=DEFAULT_FILE, help="colors.toml (default: the active theme's)")
    ap.add_argument("--name", help="theme name, for {{ name }}")
    ap.add_argument("--mode", choices=["dark", "light"], help="override the pack's mode")
    g = ap.add_mutually_exclusive_group()
    g.add_argument("--all", action="store_true")
    g.add_argument("--json", action="store_true")
    g.add_argument("--render", metavar="OUTDIR")
    g.add_argument("--stdout", metavar="TPL")
    ap.add_argument("args", nargs="*", metavar="KEY|TPL")
    a = ap.parse_args()

    if not os.path.isfile(a.file):
        sys.exit("theme-color: no such file: %s" % a.file)
    p = resolve(parse(a.file), name=a.name, mode=a.mode)
    p.setdefault("tagline", tagline(a.file))
    if a.render or a.stdout:
        p.setdefault("hostname", socket.gethostname().split(".")[0])

    def warn(token):
        print("theme-color: %s: unknown token %s" % (warn.where, token), file=sys.stderr)

    if a.all:
        for k in sorted(p):
            print("%s\t%s" % (k, p[k]))
    elif a.json:
        print(json.dumps(p, indent=2, sort_keys=True))
    elif a.render:
        os.makedirs(a.render, exist_ok=True)
        for tpl in a.args:
            out = os.path.join(a.render, os.path.basename(tpl)[:-4] if tpl.endswith(".tpl") else os.path.basename(tpl))
            if os.path.exists(out):
                continue  # the pack shipped its own; hand-tuned beats generated
            warn.where = os.path.basename(tpl)
            with open(tpl, encoding="utf-8") as fh:
                rendered = render(fh.read(), p, warn)
            with open(out, "w", encoding="utf-8") as fh:
                fh.write(rendered)
    elif a.stdout:
        warn.where = os.path.basename(a.stdout)
        with open(a.stdout, encoding="utf-8") as fh:
            sys.stdout.write(render(fh.read(), p, warn))
    else:
        if not 1 <= len(a.args) <= 2:
            ap.error("give a KEY, or one of --all / --json / --render / --stdout")
        key = a.args[0]
        fallback = a.args[1] if len(a.args) == 2 else None
        v = p.get(key) or (p.get(fallback, fallback) if fallback else None)
        if not v:
            sys.exit(1)
        print(v)


if __name__ == "__main__":
    main()
