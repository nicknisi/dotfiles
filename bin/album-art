#!/usr/bin/env bash
# Normalize system Now Playing artwork for the SketchyBar music chip.
# Usage: current-song --json | album-art
# Prints a cached 48px PNG path, or exits 1 when artwork is unavailable.
set -euo pipefail

ART=$(jq -er '.artwork | select(type == "string" and length > 0)')
KEY=$(printf '%s' "$ART" | md5 -q)
DIR="$HOME/.cache/sketchybar-artwork"
OUT="$DIR/$KEY.png"
mkdir -p "$DIR"

[ -f "$OUT" ] && { echo "$OUT"; exit 0; }

RAW=$(mktemp "$DIR/.artwork.XXXXXX")
trap 'rm -f "$RAW" "$RAW.png"' EXIT
printf '%s' "$ART" | base64 --decode > "$RAW"
sips -s format png -z 48 48 "$RAW" --out "$RAW.png" >/dev/null 2>&1
mv "$RAW.png" "$OUT"
echo "$OUT"
