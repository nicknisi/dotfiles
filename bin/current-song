#!/bin/bash
# Reports the current track from a RUNNING player (Music or Spotify).
# Default: prints "Title - Artist" only while actually playing (empty
# when paused/stopped) — the audible truth, for statusline-style uses.
# --json: {"app","song","state"} whenever a player is open with a track,
# state = playing|paused, playing app preferred over a paused one — lets
# consumers (sketchybar) show a dimmed paused chip instead of hiding.

get_now_playing() {
  osascript -l JavaScript <<'EOF'
  let playing = null, paused = null;
  const grab = (name) => {
    try {
      const app = Application(name);
      if (!app.running()) return;
      const state = app.playerState();
      if (state !== "playing" && state !== "paused") return;
      const t = app.currentTrack;
      const rec = JSON.stringify({
        app: name,
        song: `${t.name()} - ${t.artist()}`.substr(0, 50),
        state: state,
      });
      if (state === "playing") playing = playing || rec;
      else paused = paused || rec;
    } catch (e) {}
  };
  grab("Music");
  grab("Spotify");
  playing || paused || "";
EOF
}

np=$(get_now_playing)
[ -n "$np" ] || exit 0

if [ "$1" = "--json" ]; then
  echo "$np"
else
  jq -r 'select(.state == "playing").song // empty' <<<"$np"
fi
