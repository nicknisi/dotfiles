#!/bin/bash
# Prints the currently PLAYING track ("Title - Artist"), empty when
# nothing is actively playing (paused/stopped players don't count).
# --json emits {"app":"Music|Spotify","song":"Title - Artist"} for
# consumers that also need the player (sketchybar album art).

get_now_playing() {
  osascript -l JavaScript <<'EOF'
  let out = "";
  const grab = (name) => {
    if (out !== "") return;
    try {
      const app = Application(name);
      if (app.running() && app.playerState() === "playing") {
        const t = app.currentTrack;
        const song = `${t.name()} - ${t.artist()}`.substr(0, 50);
        out = JSON.stringify({ app: name, song: song });
      }
    } catch (e) {}
  };
  grab("Music");
  grab("Spotify");
  out;
EOF
}

np=$(get_now_playing)
[ -n "$np" ] || exit 0

if [ "$1" = "--json" ]; then
  echo "$np"
else
  echo "$np" | /usr/bin/python3 -c 'import json,sys; print(json.load(sys.stdin)["song"])' 2>/dev/null
fi
