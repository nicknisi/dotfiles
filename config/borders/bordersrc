#!/usr/bin/env bash

# active named theme (bin/theme) overrides the defaults below
if [[ -f "$HOME/.config/theme/current/borders.sh" ]]; then
  source "$HOME/.config/theme/current/borders.sh"
fi

options=(
  style=round
  width=6
  inactive_color="${INACTIVE_COLOR:-0xff5C6773}"
  active_color="${ACTIVE_COLOR:-glow(0xFF59C2FF)}" # default: Ayu entity blue glow
  hidpi=on
)

borders "${options[@]}"
