local cache: { [string]: string } = {}

local function radius(name: string, degrees: number): number
    local values = radii[name] or radii.Circle
    local position = (degrees % 360) / step
    local index = math.floor(position)
    local fraction = position - index
    return values[index % samples + 1] * (1 - fraction) + values[(index + 1) % samples + 1] * fraction
end

local function point(name: string, index: number, rotation: number): (number, number)
    local degrees = index * step
    local length = radius(name, degrees - rotation) * 100
    local angle = math.rad(degrees)
    return 50 + length * math.cos(angle), 50 + length * math.sin(angle)
end

local function path(name: string, rotation: number?): string
    local turn = rotation or 0
    local cached = turn == 0 and cache[name]
    if cached then
        return cached
    end
    local xs, ys = table.create(samples), table.create(samples)
    for index = 0, samples - 1 do
        xs[index + 1], ys[index + 1] = point(name, index, turn)
    end
    local parts = table.create(samples + 2)
    parts[1] = string.format("M %.2f %.2f", xs[1], ys[1])
    for index = 1, samples do
        local before = (index - 2) % samples + 1
        local here = index
        local after = index % samples + 1
        local beyond = (index + 1) % samples + 1
        parts[#parts + 1] = string.format("C %.2f %.2f %.2f %.2f %.2f %.2f",
            xs[here] + (xs[after] - xs[before]) / 6, ys[here] + (ys[after] - ys[before]) / 6,
            xs[after] - (xs[beyond] - xs[here]) / 6, ys[after] - (ys[beyond] - ys[here]) / 6,
            xs[after], ys[after])
    end
    parts[#parts + 1] = "Z"
    local built = table.concat(parts, " ")
    if turn == 0 and radii[name] then
        cache[name] = built
    end
    return built
end

local names = {}
for name in radii do
    names[#names + 1] = name
end
table.sort(names)

return table.freeze({
    names = table.freeze(names),
    viewBox = table.freeze({ 0, 0, 100, 100 }),
    radius = radius,
    path = path,
})
