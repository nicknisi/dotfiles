# Some apps write their own state into the same JSON file that holds your
# config, so path-level .gitignore rules can't separate them. These clean
# filters strip the volatile keys on the way into the index — the working tree
# keeps them, but they never reach a commit, so the file reads as unmodified.
#
# The filter *definitions* live in .git/config, which isn't tracked. Run
# `dot filters` after cloning to register them (dot link does it for you).

home/.pi/agent/settings.json filter=pi-settings
