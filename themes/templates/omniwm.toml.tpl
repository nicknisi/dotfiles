# {{ name }} ({{ mode }}) — OmniWM palette, rendered by bin/theme from themes/templates/omniwm.toml.tpl.
# bin/theme copies it to ~/.config/omniwm/shell/themes/dotfiles.toml and selects it, so the bar
# follows the theme pack. Both schemes carry the pack's palette: the pack decides light or dark,
# and bin/theme sets macOS's appearance to match.

[light]
background = "{{ background }}"
surface = "{{ mix background foreground 6% }}"
elevatedSurface = "{{ mix background foreground 11% }}"
highestSurface = "{{ mix background foreground 16% }}"
foreground = "{{ foreground }}"
secondaryForeground = "{{ mix foreground background 28% }}"
mutedForeground = "{{ mix foreground background 50% }}"
border = "{{ mix background foreground 20% }}"
accent = "{{ accent }}"
accentForeground = "{{ background }}"
accentContainer = "{{ mix background accent 28% }}"
accentContainerForeground = "{{ mix accent foreground 30% }}"
secondaryAccent = "{{ blue }}"
secondaryContainer = "{{ mix background blue 24% }}"
secondaryContainerForeground = "{{ foreground }}"
tertiaryAccent = "{{ magenta }}"
tertiaryContainer = "{{ mix background magenta 24% }}"
tertiaryContainerForeground = "{{ foreground }}"
success = "{{ green }}"
warning = "{{ yellow }}"
error = "{{ red }}"
focus = "{{ accent }}"
shadow = "{{ darker_background }}"
scrim = "{{ darker_background }}99"
badge = "{{ red }}"
red = "{{ red }}"
orange = "{{ orange }}"
yellow = "{{ yellow }}"
green = "{{ green }}"
mint = "{{ bright_green }}"
teal = "{{ cyan }}"
cyan = "{{ bright_cyan }}"
blue = "{{ blue }}"
indigo = "{{ bright_blue }}"
purple = "{{ magenta }}"
pink = "{{ bright_magenta }}"
brown = "{{ brown }}"
gray = "{{ muted }}"

[dark]
