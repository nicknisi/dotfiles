# {{ name }} — rendered by bin/theme from themes/templates/hyprlock.conf.tpl.
# config/hypr/hyprlock.conf sources this and styles the input field with these.
$theme_bg = rgba({{ background_strip }}ee)
$theme_fg = rgba({{ foreground_strip }}ff)
$theme_accent = rgba({{ accent_strip }}ee)
$theme_muted = rgba({{ muted_strip }}aa)
$theme_ok = rgba({{ green_strip }}ee)
$theme_fail = rgba({{ red_strip }}ee)
